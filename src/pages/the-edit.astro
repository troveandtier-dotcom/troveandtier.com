---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import { categories } from '../data/site';
---
<BaseLayout title="The Trove Edit — Thoughtful home essentials" description="A considered edit of useful, beautiful home essentials.">
<Header/>
<main>
<header class="wrap intro"><p class="eyebrow">The Trove Edit / Home essentials</p><h1>Useful by nature.<br/><em>Lovely by design.</em></h1><p>Practical home finds chosen to solve everyday problems, make better use of space and bring a little more ease to daily routines.</p></header>
<section class="wrap picks" id="trovePicks">
  <p class="eyebrow">THE CURRENT EDIT</p><h2>Finds worth a closer look.</h2>
  <p class="affiliate-note">Some links are affiliate links. We may earn a commission if you shop through them, at no extra cost to you.</p>
  <div id="editGrid" class="product-grid"></div><p id="editLoading" class="hint">Loading the latest finds…</p>
</section>
<section class="availability"><div class="wrap"><p class="eyebrow">OUR APPROACH</p><h2>Worth the space?</h2><p>We consider what a product solves, how it fits, what it is made from and where its limitations may be. We distinguish manufacturer information and research from hands-on testing.</p><a href="/how-we-choose">Read how we choose ↗</a></div></section>
<section class="wrap rooms"><p class="eyebrow">Explore by room</p><div>{categories.map(c=><a href={'/'+c.slug}>{c.title} <span>↗</span></a>)}</div></section>
</main>
<footer><a href="/">TROVE &amp; TIER</a><span>Thoughtful finds. Better living.</span></footer>
</BaseLayout>
<script>
import { supabase } from '../lib/supabase';
const grid=document.querySelector<HTMLElement>('#editGrid');
const loading=document.querySelector<HTMLElement>('#editLoading');
const node=(tag:string,cls:string,txt?:string)=>{const n=document.createElement(tag);if(cls)n.className=cls;if(txt!==undefined)n.textContent=txt;return n;};
async function loadEdit(){
 if(!supabase){if(loading)loading.textContent='Product listings will appear here once the site database is connected.';return;}
 const {data,error}=await supabase.from('products').select('id,name,brand,summary,image_url,pros,category:categories(name,slug),offers:product_offers(id,market,affiliate_url,canonical_url,status,retailer:retailers(name,is_active))').eq('status','published').order('published_at',{ascending:false});
 if(loading)loading.hidden=true;
 if(error){console.error('Could not load The Trove Edit:',error.message);return;}
 const products=(data||[]).map(p=>({...p,offers:(p.offers||[]).filter(o=>o.status==='active'&&o.retailer?.is_active)})).filter(p=>p.offers.length);
 if(!products.length){const empty=node('p','hint','Our first product selections are being prepared. Please check back soon.');grid?.append(empty);return;}
 for(const product of products){
  const card=node('article','product-card');
  if(product.image_url){const img=node('img','product-image') as HTMLImageElement;img.src=product.image_url;img.alt=product.name;img.loading='lazy';card.append(img);}
  card.append(node('small','brand',product.brand||'Trove & Tier selection'));
  card.append(node('h3','',product.name));
  if(product.category?.name)card.append(node('small','category',product.category.name));
  card.append(node('p','description',product.summary||'A considered find for the home.'));
  if(product.pros?.length){const ul=node('ul','');for(const point of product.pros.slice(0,3))ul.append(node('li','',point));card.append(ul);}
  const offers=node('div','offers');
  for(const offer of product.offers){const a=node('a','shop',product.offers.length>1?offer.market+' · '+(offer.retailer?.name||'Shop retailer')+' ↗':(offer.retailer?.name||'Shop retailer')+' ↗') as HTMLAnchorElement;a.href=offer.affiliate_url||offer.canonical_url;a.target='_blank';a.rel='sponsored noopener noreferrer';offers.append(a);}
  card.append(offers);grid?.append(card);
 }
}
loadEdit();
</script>
<style>
.wrap{max-width:1160px;margin:auto;padding-left:5%;padding-right:5%}.eyebrow{font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--color-deep-sage)}.intro{padding-top:85px;padding-bottom:80px;border-bottom:1px solid var(--line)}h1{font:clamp(62px,9vw,108px)/.9 var(--font-display);letter-spacing:-.035em;margin:26px 0}h1 em,h2 em{font-weight:400;color:var(--color-deep-sage)}.intro>p:last-child{max-width:620px;font-size:14px;line-height:1.9;color:#62645b}.picks{padding-top:70px;padding-bottom:85px}.picks h2{font:48px var(--font-display);margin:12px 0}.affiliate-note,.hint{font-size:11px;line-height:1.7;color:#62645b;max-width:650px}.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:28px}.product-card{background:#f1ece3;padding:18px}.product-image{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;margin-bottom:18px;background:#e7e1d6}.brand,.category{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--color-deep-sage)}.product-card h3{font:27px/1.05 var(--font-display);margin:12px 0}.description{font-size:12px;line-height:1.7;color:#62645b}.product-card ul{padding-left:18px;font-size:11px;line-height:1.7}.offers{border-top:1px solid var(--line);margin-top:16px;padding-top:12px;display:grid;gap:10px}.shop{font-size:11px;color:var(--color-deep-sage);text-decoration:underline}.availability{background:#d9d3c8;padding:75px 0}.availability h2{font:clamp(37px,5vw,60px)/1 var(--font-display);margin:18px 0}.availability p:not(.eyebrow){max-width:650px;font-size:13px;line-height:1.85;color:#5f6158}.availability a{font-size:10px;color:var(--color-deep-sage)}.rooms{padding-top:70px;padding-bottom:85px}.rooms>div{display:grid;grid-template-columns:repeat(2,1fr);gap:0 40px}.rooms a{padding:17px 0;border-top:1px solid var(--line);text-decoration:none;font:25px var(--font-display);display:flex;justify-content:space-between}.rooms a span{font:12px var(--font-body);color:var(--color-deep-sage)}footer{background:var(--color-charcoal);color:var(--color-ivory);padding:26px 5%;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.14em}footer a{color:inherit;text-decoration:none}@media(max-width:700px){.product-grid{grid-template-columns:1fr}.intro{padding-top:60px}.rooms>div{grid-template-columns:1fr}footer{flex-direction:column;gap:10px}}
</style>
