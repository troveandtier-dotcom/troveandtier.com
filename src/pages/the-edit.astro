---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import { categories } from '../data/site';
---
<BaseLayout title="The Trove Edit — Thoughtful home essentials" description="A considered approach to useful, beautiful home essentials. Product recommendations will be published only after details are checked.">
<Header/>
<main>
<header class="wrap intro"><p class="eyebrow">The Trove Edit / Home essentials</p><h1>Useful by nature.<br/><em>Lovely by design.</em></h1><p>Product discovery should make choosing easier, not noisier. Our edit will bring together practical home essentials with the details that help you decide whether something deserves a place in your home.</p></header>
<section class="wrap method"><div><p class="eyebrow">Before a product earns a place</p><h2>Worth the space?</h2><p>We look at what it solves, how it fits, what it is made from, what its limitations are and whether there are sensible alternatives.</p><a href="/how-we-choose">Read our editorial standards ↗</a></div><ol><li><b>01</b><span>Purpose and everyday usefulness</span></li><li><b>02</b><span>Dimensions, fit and compatibility</span></li><li><b>03</b><span>Materials, care and durability information</span></li><li><b>04</b><span>Trade-offs and alternative approaches</span></li><li><b>05</b><span>Market-specific retailer and price checks</span></li></ol></section>
<section class="availability"><div class="wrap"><p class="eyebrow">The edit is being researched</p><h2>No filler. No made-up ratings.<br/><em>Only considered recommendations.</em></h2><p>We are preparing our first product selections. We will not publish sample products, invented prices, unverified stock information or claims of hands-on testing that has not taken place.</p><a href="/categories">Explore room-by-room ideas while we build the edit ↗</a></div></section>
<section class="wrap rooms"><p class="eyebrow">Explore by room</p><div>{categories.map(c=><a href={'/'+c.slug}>{c.title} <span>↗</span></a>)}</div></section>
</main>
<footer><a href="/">TROVE &amp; TIER</a><span>Thoughtful finds. Better living.</span></footer>
</BaseLayout>
<style>
.wrap{max-width:1160px;margin:auto;padding-left:5%;padding-right:5%}.intro{padding-top:85px;padding-bottom:80px;border-bottom:1px solid var(--line)}.eyebrow{font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--color-deep-sage)}h1{font:clamp(62px,9vw,108px)/.9 var(--font-display);letter-spacing:-.035em;margin:26px 0}h1 em,h2 em{font-weight:400;color:var(--color-deep-sage)}.intro>p:last-child{max-width:620px;font-size:14px;line-height:1.9;color:#62645b}.method{display:grid;grid-template-columns:1fr 1fr;gap:12%;padding-top:75px;padding-bottom:85px}.method h2{font:58px var(--font-display);margin:15px 0}.method p{font-size:13px;line-height:1.85;color:#62645b;max-width:430px}.method a,.availability a{font-size:10px;color:var(--color-deep-sage)}ol{list-style:none;padding:0;margin:0;border-top:1px solid var(--line)}li{display:flex;gap:22px;padding:17px 0;border-bottom:1px solid var(--line);font-size:12px}li b{font-size:9px;color:var(--color-deep-sage);letter-spacing:.12em}.availability{background:#d9d3c8;padding:75px 0}.availability h2{font:clamp(37px,5vw,60px)/1 var(--font-display);margin:18px 0}.availability p:not(.eyebrow){max-width:650px;font-size:13px;line-height:1.85;color:#5f6158}.rooms{padding-top:70px;padding-bottom:85px}.rooms>div{display:grid;grid-template-columns:repeat(2,1fr);gap:0 40px}.rooms a{padding:17px 0;border-top:1px solid var(--line);text-decoration:none;font:25px var(--font-display);display:flex;justify-content:space-between}.rooms a span{font:12px var(--font-body);color:var(--color-deep-sage)}footer{background:var(--color-charcoal);color:var(--color-ivory);padding:26px 5%;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.14em}footer a{color:inherit;text-decoration:none}@media(max-width:650px){.intro{padding-top:60px}.method{grid-template-columns:1fr;gap:35px}.rooms>div{grid-template-columns:1fr}footer{flex-direction:column;gap:10px}}
</style>
