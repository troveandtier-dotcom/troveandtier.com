---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { articles, fullManuscriptSlugs } from '../data/site';
import { getPublishedArticles } from '../lib/public-content';
const publishedArticles = await getPublishedArticles();
const featuredSlugs = ['under-sink-storage','pantry-organization-system','small-bathroom-storage','no-drill-storage'];
const featuredStories = featuredSlugs.flatMap((slug) => {
  const article = articles.find(item => item.slug === slug);
  const image = ({
    'under-sink-storage': '/editorial/under-sink-storage.webp',
    'pantry-organization-system': '/editorial/pantry-organization.webp',
    'small-bathroom-storage': '/editorial/small-bathroom.webp',
    'no-drill-storage': '/editorial/no-drill-storage.webp'
  } as Record<string,string>)[slug];
  return article && fullManuscriptSlugs.includes(slug) && !publishedArticles.some(live => live.slug === slug)
    ? [{ ...article, image }]
    : [];
});
const rooms = [
  {name:'Kitchen',desc:'Make every shelf and surface work harder.',image:'/rooms/room-kitchen.webp'},
  {name:'Bathroom',desc:'A calmer start and finish to the day.',image:'/rooms/room-bathroom.webp'},
  {name:'Bedroom',desc:'Restful details, considered storage.',image:'/rooms/room-bedroom.webp'},
  {name:'Closet',desc:'A place for everything you reach for.',image:'/rooms/room-closet.webp'},
  {name:'Laundry',desc:'Small systems that simplify the routine.',image:'/rooms/room-laundry.webp'},
  {name:'Small spaces',desc:'Thoughtful solutions for compact homes.',image:'/rooms/room-small-spaces.webp'}
];
---
<BaseLayout>
  <Header />
  <main>
    <section class="hero wrap">
      <div class="hero-copy"><p class="eyebrow">A considered guide to home &amp; living</p><h1>Make room for<br/><em>better living.</em></h1><p class="intro">The morning rush. The cupboard that never quite works. The quiet relief of finding what you need without moving everything else. We help make those everyday moments feel easier—with thoughtful ideas and finds that earn their place.</p><a class="button" href="/journal">Explore the journal <span>↗</span></a></div>
      <div class="hero-art"><img src="/editorial/homepage-kitchen-hero.webp" alt="Warm, naturally lit kitchen with oak cabinetry and a pale stone worktop" width="1600" height="1067" fetchpriority="high" decoding="async" /></div>
      <div class="hero-foot"><span>THE WORLD OF HOME, CONSIDERED.</span><span>01 — 06</span></div>
    </section>
    <section class="section wrap" id="explore"><div class="section-head"><div><p class="eyebrow">Find your starting point</p><h2>Explore by room</h2></div><a class="text-link" href="/categories">View all spaces ↗</a></div><div class="room-grid">{rooms.map((room,i)=><a class="room-card" href={'/'+room.name.toLowerCase().replaceAll(' ','-')}><div class="room-visual"><img src={room.image} alt={room.name+' interior and storage inspiration'} width="900" height="600" loading="lazy" decoding="async" /><span>0{i+1}</span></div><div class="room-copy"><h3>{room.name}</h3><p>{room.desc}</p></div><span class="arrow">↗</span></a>)}</div></section>
    <section class="feature-band"><div class="wrap feature-inner"><p class="eyebrow">The latest edit · A thoughtful place to begin</p><div class="feature-grid"><h2>Good spaces<br/><em>start with</em><br/>good choices.</h2><div><p>From hardworking kitchen organisers to the little details that make a room feel finished, discover ideas chosen for usefulness as much as beauty.</p><a class="button button-dark" href="/journal">Read the journal <span>↗</span></a></div></div></div></section>
    <section class="section wrap"><div class="section-head"><div><p class="eyebrow">Practical ideas, beautifully considered</p><h2>Solve a space problem</h2></div><p class="section-note">A more useful home doesn't always need more room. Sometimes it needs a better idea.</p></div><div class="problem-grid"><a href="/journal/pantry-organization-system" class="problem-card"><div class="problem-image"><img src="/editorial/pantry-organization.webp" alt="Organised pantry shelves with visible food categories and practical containers" width="900" height="600" loading="lazy" decoding="async" /><span>01 / KITCHEN</span></div><h3>Build a pantry around rotation, not containers</h3><p>Make food easier to find, use older stock first and keep storage conditions in view.</p></a><a href="/journal/under-sink-storage" class="problem-card"><div class="problem-image"><img src="/editorial/under-sink-storage.webp" alt="Under-sink cabinet storage arranged around visible plumbing and valves" width="900" height="600" loading="lazy" decoding="async" /><span>02 / KITCHEN</span></div><h3>Make under-sink storage work around the pipes</h3><p>Measure the space, keep shut-off valves reachable and choose storage that fits.</p></a><a href="/journal/small-bathroom-storage" class="problem-card"><div class="problem-image"><img src="/editorial/small-bathroom.webp" alt="Compact bathroom with warm neutral finishes and practical vanity storage" width="900" height="600" loading="lazy" decoding="async" /><span>03 / BATHROOM</span></div><h3>Make a small bathroom feel more considered</h3><p>Plan around moisture, plumbing, daily essentials and the space you really have.</p></a></div></section>
    <section class="edit-strip"><div class="wrap edit-inner"><div><p class="eyebrow">The Trove Edit</p><h2>A product should<br/><em>earn its place.</em></h2><p>We are preparing a considered selection. Every item must solve a real problem, fit the space it is meant for and stand up to scrutiny. Until then, see the standards behind every recommendation.</p><a class="button" href="/how-we-choose">How we choose <span>↗</span></a></div><div class="edit-tiles"><div class="tile tile-a">FIT &amp;<br/>FUNCTION</div><div class="tile tile-b">MATERIALS<br/>&amp; CARE</div><div class="tile tile-c">LIMITS &amp;<br/>TRADE-OFFS</div></div></div></section>
    <section class="section wrap worth"><div><p class="eyebrow">Our point of view</p><h2>Worth the<br/><em>space?</em></h2></div><div class="worth-copy"><p>Every home has limits. We look beyond the pretty picture to ask the useful questions: Will it fit? What is it made of? What does it solve? And is there a better alternative?</p><a class="text-link" href="/how-we-choose">How we choose ↗</a></div></section>
    <section class="journal-band"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Ideas for a more considered home</p><h2>From the journal</h2></div><a class="text-link" href="/journal">Visit the journal ↗</a></div><div class="journal-grid">{featuredStories.map((story,i)=><article class="journal-card"><a class="journal-card-main" href={'/journal/'+story.slug}><div class="journal-art"><img src={story.image} alt={story.title+' editorial image'} width="900" height="600" loading="lazy" decoding="async" /><span>{story.category}</span><b>0{i+1}</b></div><p class="eyebrow">{story.category} / EDITORIAL GUIDE · {story.read}</p><h3>{story.title}</h3><p>{story.excerpt}</p></a><a class="journal-read" href={'/journal/'+story.slug}>Read guide ↗</a></article>)}</div></div></section>
  </main>
  {publishedArticles.length > 0 && <section class="section wrap live-journal"><div class="section-head"><div><p class="eyebrow">Fresh from the studio</p><h2>Recently published</h2></div><a class="text-link" href="/journal">All journal stories ↗</a></div><div class="live-journal-grid">{publishedArticles.slice(0,3).map(article=><article><p class="eyebrow">{article.category?.name || 'HOME & LIVING'}</p><h3><a href={'/journal/'+article.slug}>{article.title}</a></h3><p>{article.excerpt}</p><a class="text-link" href={'/journal/'+article.slug}>Read story ↗</a></article>)}</div></section>}
  <footer class="footer"><div class="wrap footer-top"><div class="footer-brand-lockup"><a class="footer-brand-mark" href="/" aria-label="Trove & Tier home"><img src="/brand/trove-tier-logo.png" alt="Trove & Tier approved geometric logo" width="58" height="58" /></a><p class="footer-tagline">Thoughtful finds. Better living.</p><span class="footer-descriptor">HOME &amp; LIVING</span></div><div class="footer-links"><a href="/about">About</a><a href="/how-we-choose">How we choose</a><a href="/affiliate-disclosure">Affiliate disclosure</a><a href="/contact">Contact &amp; partnerships</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Trove &amp; Tier</span><span>Made for living well.</span><div><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div></div></footer>
</BaseLayout>
<style>
.wrap{max-width:var(--content-width);margin:auto;padding-left:5%;padding-right:5%}.hero{padding-top:72px;padding-bottom:26px;display:grid;grid-template-columns:1fr 1.05fr;gap:38px;align-items:center;position:relative}.eyebrow{font-size:9px;letter-spacing:.19em;text-transform:uppercase;color:var(--color-deep-sage);font-weight:600}.hero h1{font:clamp(60px,7.5vw,106px)/.91 var(--font-display);letter-spacing:-.035em;margin:28px 0}.hero h1 em,h2 em{font-weight:400;color:var(--color-deep-sage)}.intro{max-width:390px;font-size:14px;line-height:1.8;color:#62645b}.button{display:inline-flex;gap:38px;align-items:center;background:var(--color-deep-sage);color:#fff;text-decoration:none;padding:15px 18px;font-size:10px;letter-spacing:.04em;margin-top:20px}.button span{font-size:15px}.hero-art{height:clamp(390px,43vw,560px);min-height:390px;background:#d4cbbd;position:relative;overflow:hidden}.hero-art img{width:100%;height:100%;display:block;object-fit:cover;object-position:58% center}.hero-foot{grid-column:1/-1;display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:15px;font-size:8px;letter-spacing:.16em;margin-top:18px}.section{padding-top:100px;padding-bottom:100px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:34px}.section h2,.section-head h2,.feature-grid h2,.edit-inner h2{font:clamp(42px,5vw,64px)/.95 var(--font-display);letter-spacing:-.025em;margin:12px 0 0}.text-link{font-size:10px;text-decoration:none;border-bottom:1px solid var(--color-stone);padding-bottom:7px}.room-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:38px 22px}.room-card{text-decoration:none;position:relative}.room-visual{aspect-ratio:3/2;height:auto;min-height:190px;position:relative;overflow:hidden;padding:0;background:#d8d2c7}.room-visual img{width:100%;height:100%;display:block;object-fit:cover;object-position:center;transition:transform .35s ease}.room-card:hover .room-visual img{transform:scale(1.025)}.room-visual>span{position:absolute;top:14px;left:15px;font-size:9px;letter-spacing:.12em;color:#fff;text-shadow:0 1px 5px #333}.room-copy h3{font:27px var(--font-display);margin:13px 0 3px}.room-copy p,.problem-card p,.journal-grid article>p:last-child{font-size:11px;line-height:1.65;color:#66685f;margin:0}.arrow{position:absolute;right:0;bottom:4px}.feature-band{background:#d9d3c8;padding:80px 0}.feature-inner>.eyebrow{margin:0 0 28px}.feature-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:10%;align-items:end}.feature-grid h2{font-size:clamp(58px,7vw,92px)}.feature-grid>div p,.worth-copy p,.edit-inner>div>p:not(.eyebrow){font-size:13px;line-height:1.85;color:#5f6158}.button-dark{background:var(--color-charcoal)}.section-note{font-size:11px;line-height:1.7;max-width:280px;color:#66685f}.problem-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.problem-card{text-decoration:none}.problem-image{aspect-ratio:3/2;position:relative;overflow:hidden;background:#d8d2c7}.problem-image img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;transition:transform .35s ease}.problem-card:hover .problem-image img{transform:scale(1.02)}.problem-image span{position:absolute;left:14px;top:14px;font-size:9px;letter-spacing:.15em;color:#fff;text-shadow:0 1px 5px #333}.problem-card h3{font:25px/1.05 var(--font-display);margin:17px 0 7px}.edit-strip{background:var(--color-charcoal);color:var(--color-ivory);padding:85px 0}.edit-inner{display:grid;grid-template-columns:.8fr 1.2fr;gap:10%;align-items:center}.edit-inner .eyebrow{color:#c4c9b9}.edit-inner h2{font-size:clamp(50px,6vw,78px)}.edit-inner>div>p:not(.eyebrow){color:#c7c3b9;max-width:360px}.edit-tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;align-items:center}.tile{height:220px;padding:12px;display:flex;align-items:end;font-size:9px;letter-spacing:.13em;color:#33352f}.tile-a{background:#b9b19f}.tile-b{background:#8b9482;margin-top:36px}.tile-c{background:#c7bdae;margin-top:-20px}.worth{display:grid;grid-template-columns:1fr 1fr;gap:12%;align-items:center}.worth h2{font-size:clamp(65px,8vw,100px)}.worth-copy{max-width:430px}.journal-band{background:var(--color-paper);padding:85px 0}.journal-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:38px 28px}.journal-card{border-top:1px solid var(--line);padding-top:16px}.journal-card-main{display:block;text-decoration:none;color:inherit}.journal-art{aspect-ratio:3/2;height:auto;margin-bottom:20px;position:relative;display:flex;align-items:flex-end;justify-content:space-between;padding:17px;overflow:hidden;background:#d8d2c7}.journal-art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;transition:transform .35s ease}.journal-card:hover .journal-art img{transform:scale(1.02)}.journal-art span,.journal-art b{position:relative;z-index:1;text-shadow:0 1px 5px rgba(0,0,0,.55);color:#fff}.journal-art span{font-size:8px;letter-spacing:.16em;text-transform:uppercase}.journal-art b{font:32px var(--font-display);color:rgba(255,255,255,.82)}.journal-grid .eyebrow{font-size:8px}.journal-grid h3{font:clamp(27px,2.7vw,36px)/1.04 var(--font-display);margin:11px 0;max-width:22ch}.journal-card-main>p:last-child{font-size:11px;line-height:1.7;color:#66685f}.journal-read{display:inline-block;margin-top:12px;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--color-deep-sage);text-decoration:none;border-bottom:1px solid var(--color-stone);padding-bottom:5px}.live-journal{padding-top:0}.live-journal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.live-journal-grid article{border-top:1px solid var(--line);padding:18px 0}.live-journal-grid h3{font:28px/1.05 var(--font-display);margin:12px 0}.live-journal-grid h3 a{text-decoration:none}.live-journal-grid article>p:not(.eyebrow){font-size:12px;line-height:1.7;color:#66685f}.footer{background:#33352f;color:#e9e2d7;padding:55px 0 22px}.footer-top,.footer-bottom{display:flex;justify-content:space-between;gap:30px}.footer-brand-lockup{display:flex;flex-direction:column;align-items:flex-start;gap:4px}.footer-brand-mark img{display:block;width:58px;height:58px;object-fit:contain}.footer-tagline{font:23px/1.1 var(--font-display);color:#e9e2d7;margin:5px 0 0}.footer-descriptor{font:8px var(--font-body);letter-spacing:.24em;color:#c2c0b7}.footer-links{display:grid;grid-template-columns:repeat(2,auto);gap:13px 30px;align-content:start}.footer-links a,.footer-bottom a{font-size:10px;text-decoration:none;color:#e9e2d7}.footer-bottom{border-top:1px solid #65665f;margin-top:45px;padding-top:18px;font-size:9px;color:#c2c0b7}.footer-bottom div{display:flex;gap:20px}
@media(max-width:760px){.live-journal-grid{grid-template-columns:1fr}.hero{grid-template-columns:1fr;padding-top:48px;gap:25px}.hero-copy{max-width:620px}.hero-art{height:auto;min-height:0;aspect-ratio:4/3}.hero-art img{object-position:60% center}.hero h1{font-size:clamp(66px,11vw,82px);margin:22px 0}.intro{max-width:560px}.section{padding-top:72px;padding-bottom:72px}.room-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 16px}.room-visual{aspect-ratio:3/2;min-height:0}.feature-band,.edit-strip,.journal-band{padding:66px 0}.feature-grid,.edit-inner,.worth{grid-template-columns:1fr;gap:28px}.problem-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 18px}.journal-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:30px 18px}.journal-art{aspect-ratio:4/3}.edit-tiles{max-width:520px}.footer-top{flex-direction:column}.footer-bottom{flex-wrap:wrap}}
@media(max-width:440px){.wrap{padding-left:5.5%;padding-right:5.5%}.hero{padding-top:38px;gap:22px}.hero h1{font-size:clamp(58px,14vw,68px);line-height:.94}.hero-art{aspect-ratio:1/1.08}.hero-foot{font-size:7px;letter-spacing:.1em}.room-grid{gap:23px 12px}.room-visual{aspect-ratio:4/5}.room-copy h3{font-size:23px}.room-copy p{font-size:10px}.section-head{align-items:start;gap:18px;flex-direction:column}.problem-grid,.journal-grid{grid-template-columns:1fr}.problem-image{aspect-ratio:16/10}.journal-art{aspect-ratio:16/10}.journal-grid h3{font-size:30px}.feature-grid h2{font-size:58px}.edit-tiles{gap:7px}.tile{height:160px;padding:9px;font-size:8px}.footer-links{grid-template-columns:1fr 1fr}.footer-bottom{gap:12px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}
</style>
