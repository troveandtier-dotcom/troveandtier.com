---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { getPublishedArticles } from '../lib/public-content';
const publishedArticles = await getPublishedArticles();
const rooms = [
  {name:'Kitchen',desc:'Make every shelf and surface work harder.',tone:'sage'},
  {name:'Bathroom',desc:'A calmer start and finish to the day.',tone:'stone'},
  {name:'Bedroom',desc:'Restful details, considered storage.',tone:'paper'},
  {name:'Closet',desc:'A place for everything you reach for.',tone:'stone'},
  {name:'Laundry',desc:'Small systems that simplify the routine.',tone:'sage'},
  {name:'Small spaces',desc:'Thoughtful solutions for compact homes.',tone:'paper'}
];
---
<BaseLayout>
  <Header />
  <main>
    <section class="hero wrap">
      <div class="hero-copy"><p class="eyebrow">A considered guide to home &amp; living</p><h1>Make room for<br/><em>better living.</em></h1><p class="intro">The morning rush. The cupboard that never quite works. The quiet relief of finding what you need without moving everything else. We help make those everyday moments feel easier—with thoughtful ideas and finds that earn their place.</p><a class="button" href="/the-edit">Explore the edit <span>↗</span></a></div>
      <div class="hero-art" role="img" aria-label="Abstract warm-toned architectural shapes representing a thoughtfully arranged home"><div class="arch arch-one"></div><div class="arch arch-two"></div><div class="arch arch-three"></div><span class="art-note">THE ART OF<br/>LIVING WELL</span></div>
      <div class="hero-foot"><span>THE WORLD OF HOME, CONSIDERED.</span><span>01 — 06</span></div>
    </section>
    <section class="section wrap" id="explore"><div class="section-head"><div><p class="eyebrow">Find your starting point</p><h2>Explore by room</h2></div><a class="text-link" href="/categories">View all spaces ↗</a></div><div class="room-grid">{rooms.map((room,i)=><a class="room-card" href={'/'+room.name.toLowerCase().replaceAll(' ','-')}><div class={'room-visual '+room.tone}><span>0{i+1}</span><div class="shape"></div></div><div class="room-copy"><h3>{room.name}</h3><p>{room.desc}</p></div><span class="arrow">↗</span></a>)}</div></section>
    <section class="feature-band"><div class="wrap feature-inner"><p class="eyebrow">The latest edit · A thoughtful place to begin</p><div class="feature-grid"><h2>Good spaces<br/><em>start with</em><br/>good choices.</h2><div><p>From hardworking kitchen organisers to the little details that make a room feel finished, discover ideas chosen for usefulness as much as beauty.</p><a class="button button-dark" href="/journal">Read the journal <span>↗</span></a></div></div></div></section>
    <section class="section wrap"><div class="section-head"><div><p class="eyebrow">Practical ideas, beautifully considered</p><h2>Solve a space problem</h2></div><p class="section-note">A more useful home doesn't always need more room. Sometimes it needs a better idea.</p></div><div class="problem-grid"><a href="/journal/small-kitchen-planning" class="problem-card"><div class="problem-image kitchen-art"><span>01 / KITCHEN</span></div><h3>Make a small kitchen work harder</h3><p>Ideas for the cupboards, counters and corners you already have.</p></a><a href="/journal/under-sink-storage" class="problem-card"><div class="problem-image bath-art"><span>02 / KITCHEN</span></div><h3>Make under-sink storage work around the pipes</h3><p>Measure the space, keep shut-off valves reachable and choose storage that fits.</p></a><a href="/journal/closet-reset" class="problem-card"><div class="problem-image closet-art"><span>03 / CLOSET</span></div><h3>Give your wardrobe a little breathing room</h3><p>Thoughtful storage and a clearer view of what you own.</p></a></div></section>
    <section class="edit-strip"><div class="wrap edit-inner"><div><p class="eyebrow">The Trove Edit</p><h2>Useful by nature.<br/><em>Lovely by design.</em></h2><p>Discover considered home essentials across affordable, mid-range and premium price points.</p><a class="button" href="/the-edit">Browse the product edit <span>↗</span></a></div><div class="edit-tiles"><div class="tile tile-a">KITCHEN<br/>TOOLS</div><div class="tile tile-b">EVERYDAY<br/>OBJECTS</div><div class="tile tile-c">SMART<br/>STORAGE</div></div></div></section>
    <section class="section wrap worth"><div><p class="eyebrow">Our point of view</p><h2>Worth the<br/><em>space?</em></h2></div><div class="worth-copy"><p>Every home has limits. We look beyond the pretty picture to ask the useful questions: Will it fit? What is it made of? What does it solve? And is there a better alternative?</p><a class="text-link" href="/how-we-choose">How we choose ↗</a></div></section>
    <section class="journal-band"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Ideas for a more considered home</p><h2>From the journal</h2></div><a class="text-link" href="/journal">Visit the journal ↗</a></div><div class="journal-grid"><article><a href="/journal/small-kitchen-planning" aria-label="Read A more useful small kitchen starts with a plan"><div class="journal-art art-one"></div></a><p class="eyebrow">THE PANTRY GUIDE</p><h3><a href="/journal/pantry-organization-system">A pantry that works: building a better food storage system</a></h3><p>Build a food-storage system around visibility, rotation and the way you cook.</p></article><article><a href="/journal/under-sink-storage" aria-label="Read How to think through under-sink storage"><div class="journal-art art-two"></div></a><p class="eyebrow">THE KITCHEN GUIDE</p><h3><a href="/journal/under-sink-storage">How to think through under-sink storage</a></h3><p>Small habits and useful systems that make a difference.</p></article><article><a href="/journal/closet-reset" aria-label="Read A thoughtful wardrobe reset"><div class="journal-art art-three"></div></a><p class="eyebrow">THE CLOSET GUIDE</p><h3><a href="/journal/closet-reset">A thoughtful wardrobe reset, one zone at a time</a></h3><p>What to look for before bringing something home.</p></article></div></div></section>
  </main>
  {publishedArticles.length > 0 && <section class="section wrap live-journal"><div class="section-head"><div><p class="eyebrow">Fresh from the studio</p><h2>Recently published</h2></div><a class="text-link" href="/journal">All journal stories ↗</a></div><div class="live-journal-grid">{publishedArticles.slice(0,3).map(article=><article><p class="eyebrow">{article.category?.name || 'HOME & LIVING'}</p><h3><a href={'/journal/'+article.slug}>{article.title}</a></h3><p>{article.excerpt}</p><a class="text-link" href={'/journal/'+article.slug}>Read story ↗</a></article>)}</div></section>}
  <footer class="footer"><div class="wrap footer-top"><div><a class="footer-brand" href="/">TROVE &amp; TIER<span>HOME &amp; LIVING</span></a><p>Thoughtful finds. Better living.</p></div><div class="footer-links"><a href="/about">About</a><a href="/how-we-choose">How we choose</a><a href="/affiliate-disclosure">Affiliate disclosure</a><a href="/contact">Contact &amp; partnerships</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Trove &amp; Tier</span><span>Made for living well.</span><div><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div></div></footer>
</BaseLayout>
<style>
.wrap{max-width:var(--content-width);margin:auto;padding-left:5%;padding-right:5%}.hero{padding-top:72px;padding-bottom:26px;display:grid;grid-template-columns:1fr 1.05fr;gap:38px;align-items:center;position:relative}.eyebrow{font-size:9px;letter-spacing:.19em;text-transform:uppercase;color:var(--color-deep-sage);font-weight:600}.hero h1{font:clamp(60px,7.5vw,106px)/.91 var(--font-display);letter-spacing:-.035em;margin:28px 0}.hero h1 em,h2 em{font-weight:400;color:var(--color-deep-sage)}.intro{max-width:390px;font-size:14px;line-height:1.8;color:#62645b}.button{display:inline-flex;gap:38px;align-items:center;background:var(--color-deep-sage);color:#fff;text-decoration:none;padding:15px 18px;font-size:10px;letter-spacing:.04em;margin-top:20px}.button span{font-size:15px}.hero-art{height:440px;background:#d4cbbd;position:relative;overflow:hidden}.arch{position:absolute}.arch-one{width:56%;height:76%;bottom:0;left:10%;background:#8e9687;border-radius:48% 48% 0 0}.arch-two{width:38%;height:52%;bottom:0;right:8%;background:#b18c62;border-radius:48% 48% 0 0}.arch-three{width:18%;height:35%;bottom:0;left:48%;background:#f1e8d8}.art-note{position:absolute;top:28px;right:28px;font:italic 18px var(--font-display);line-height:1.05;text-align:right}.hero-foot{grid-column:1/-1;display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:15px;font-size:8px;letter-spacing:.16em;margin-top:18px}.section{padding-top:100px;padding-bottom:100px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:34px}.section h2,.section-head h2,.feature-grid h2,.edit-inner h2{font:clamp(42px,5vw,64px)/.95 var(--font-display);letter-spacing:-.025em;margin:12px 0 0}.text-link{font-size:10px;text-decoration:none;border-bottom:1px solid var(--color-stone);padding-bottom:7px}.room-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px 18px}.room-card{text-decoration:none;position:relative}.room-visual{height:210px;position:relative;overflow:hidden;display:flex;justify-content:space-between;padding:15px;font-size:9px;letter-spacing:.12em}.room-visual.sage{background:#b5b9a9}.room-visual.stone{background:#c7bdae}.room-visual.paper{background:#f3eee5}.shape{position:absolute;width:58%;height:75%;bottom:-2px;right:12%;background:rgba(255,255,255,.35);border-radius:48% 48% 0 0}.room-card:nth-child(2n) .shape{width:42%;height:60%;right:18%;border-radius:0;background:rgba(120,130,115,.34)}.room-copy h3{font:27px var(--font-display);margin:13px 0 3px}.room-copy p,.problem-card p,.journal-grid article>p:last-child{font-size:11px;line-height:1.65;color:#66685f;margin:0}.arrow{position:absolute;right:0;bottom:4px}.feature-band{background:#d9d3c8;padding:80px 0}.feature-inner>.eyebrow{margin:0 0 28px}.feature-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:10%;align-items:end}.feature-grid h2{font-size:clamp(58px,7vw,92px)}.feature-grid>div p,.worth-copy p,.edit-inner>div>p:not(.eyebrow){font-size:13px;line-height:1.85;color:#5f6158}.button-dark{background:var(--color-charcoal)}.section-note{font-size:11px;line-height:1.7;max-width:280px;color:#66685f}.problem-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.problem-card{text-decoration:none}.problem-image{height:230px;padding:14px;font-size:9px;letter-spacing:.15em}.kitchen-art{background:linear-gradient(135deg,#b9b19f,#e4ded2)}.bath-art{background:linear-gradient(135deg,#aab1a0,#d8d7c9)}.closet-art{background:linear-gradient(135deg,#c1ad98,#e7dfd3)}.problem-card h3{font:25px/1.05 var(--font-display);margin:17px 0 7px}.edit-strip{background:var(--color-charcoal);color:var(--color-ivory);padding:85px 0}.edit-inner{display:grid;grid-template-columns:.8fr 1.2fr;gap:10%;align-items:center}.edit-inner .eyebrow{color:#c4c9b9}.edit-inner h2{font-size:clamp(50px,6vw,78px)}.edit-inner>div>p:not(.eyebrow){color:#c7c3b9;max-width:360px}.edit-tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;align-items:center}.tile{height:220px;padding:12px;display:flex;align-items:end;font-size:9px;letter-spacing:.13em;color:#33352f}.tile-a{background:#b9b19f}.tile-b{background:#8b9482;margin-top:36px}.tile-c{background:#c7bdae;margin-top:-20px}.worth{display:grid;grid-template-columns:1fr 1fr;gap:12%;align-items:center}.worth h2{font-size:clamp(65px,8vw,100px)}.worth-copy{max-width:430px}.journal-band{background:var(--color-paper);padding:85px 0}.journal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.journal-art{height:190px;margin-bottom:20px}.art-one{background:#c6b9a6}.art-two{background:#aab19f}.art-three{background:#d5cbbd}.journal-grid .eyebrow{font-size:8px}.journal-grid h3{font:27px/1.05 var(--font-display);margin:9px 0}.journal-grid h3 a{text-decoration:none}.journal-grid article>a{display:block}.live-journal{padding-top:0}.live-journal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.live-journal-grid article{border-top:1px solid var(--line);padding:18px 0}.live-journal-grid h3{font:28px/1.05 var(--font-display);margin:12px 0}.live-journal-grid h3 a{text-decoration:none}.live-journal-grid article>p:not(.eyebrow){font-size:12px;line-height:1.7;color:#66685f}.footer{background:#33352f;color:#e9e2d7;padding:55px 0 22px}.footer-top,.footer-bottom{display:flex;justify-content:space-between;gap:30px}.footer-brand{font:26px var(--font-display);text-decoration:none;letter-spacing:.06em}.footer-brand span{display:block;font:8px var(--font-body);letter-spacing:.2em;margin-top:5px}.footer-top p{font-size:11px;color:#c2c0b7}.footer-links{display:grid;grid-template-columns:repeat(2,auto);gap:13px 30px;align-content:start}.footer-links a,.footer-bottom a{font-size:10px;text-decoration:none;color:#e9e2d7}.footer-bottom{border-top:1px solid #65665f;margin-top:45px;padding-top:18px;font-size:9px;color:#c2c0b7}.footer-bottom div{display:flex;gap:20px}
@media(max-width:760px){.live-journal-grid{grid-template-columns:1fr}.hero{grid-template-columns:1fr;padding-top:48px;gap:25px}.hero-art{height:310px}.hero h1{font-size:72px}.section{padding-top:70px;padding-bottom:70px}.room-grid{grid-template-columns:repeat(2,1fr)}.room-visual{height:170px}.feature-grid,.edit-inner,.worth{grid-template-columns:1fr;gap:28px}.problem-grid,.journal-grid{grid-template-columns:1fr 1fr}.problem-card:last-child,.journal-grid article:last-child{display:none}.edit-tiles{max-width:520px}.footer-top{flex-direction:column}.footer-bottom{flex-wrap:wrap}}
@media(max-width:440px){.hero h1{font-size:62px}.room-grid{gap:22px 12px}.room-visual{height:145px}.room-copy h3{font-size:23px}.section-head{align-items:start;gap:18px;flex-direction:column}.problem-grid,.journal-grid{grid-template-columns:1fr}.problem-card:last-child,.journal-grid article:last-child{display:block}.problem-image,.journal-art{height:190px}.footer-links{grid-template-columns:1fr 1fr}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}
</style>
