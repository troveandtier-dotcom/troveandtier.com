---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { articles, fullManuscriptSlugs } from '../data/site';
import { getPublishedArticles } from '../lib/public-content';
const publishedArticles = await getPublishedArticles();
const homeJournal = fullManuscriptSlugs.flatMap(slug => {
  const article = articles.find(item => item.slug === slug);
  return article && !publishedArticles.some(live => live.slug === slug)
    ? [{ slug: article.slug, title: article.title, excerpt: article.excerpt, category: article.category, read: article.read }]
    : [];
});
const storyPositions: Record<string,string> = {
  'under-sink-storage':'0 0',
  'pantry-organization-system':'-200px 0',
  'small-bathroom-storage':'-400px 0',
  'no-drill-storage':'-600px 0'
};
const rooms = [
  {name:'Kitchen',desc:'Make every shelf and surface work harder.',href:'/kitchen',position:'0 -112px'},
  {name:'Bathroom',desc:'A calmer start and finish to the day.',href:'/bathroom',position:'-200px -112px'},
  {name:'Bedroom',desc:'Restful details, considered storage.',href:'/bedroom',position:'-400px -112px'},
  {name:'Closet',desc:'A place for everything you reach for.',href:'/closet',position:'-600px -112px'},
  {name:'Laundry',desc:'Small systems that simplify the routine.',href:'/laundry',position:'0 -225px'},
  {name:'Small Spaces',desc:'Thoughtful solutions for compact homes.',href:'/small-spaces',position:'-200px -225px'}
];
---
<BaseLayout title="Trove & Tier — Thoughtful finds. Better living." description="Thoughtful ideas, useful storage and considered finds for the spaces you live in every day.">
  <Header />
  <main>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">A considered guide to home &amp; living</p>
        <h1 id="hero-title">Make room for<br/><em>better living.</em></h1>
        <p class="intro">Thoughtful ideas, useful storage and considered finds for the spaces you live in every day.</p>
        <div class="hero-actions">
          <a class="button" href="/journal">Explore the Journal <span>↗</span></a>
          <a class="button button-outline" href="/the-edit">Discover The Edit <span>↗</span></a>
        </div>
        <p class="hero-note">THE WORLD OF HOME, CONSIDERED.</p>
      </div>
      <div class="hero-photo">
        <img src="/images/editorial/homepage-kitchen-hero.webp" alt="Warm, naturally lit kitchen with oak cabinetry, pale stone counters and considered everyday details" width="640" height="427" loading="eager" fetchpriority="high" decoding="async"/>
        <span class="photo-caption">A HOME THAT WORKS BEAUTIFULLY.</span>
      </div>
    </section>

    <section class="journal-feature wrap" aria-labelledby="journal-title">
      <div class="section-head">
        <div><p class="eyebrow">Practical ideas, beautifully considered</p><h2 id="journal-title">The Journal</h2></div>
        <a class="text-link" href="/journal">View all articles ↗</a>
      </div>
      <div class="journal-grid">
        {homeJournal.map((story,i) => <article class="journal-card">
          <a class="journal-card-main" href={'/journal/'+story.slug}>
            <div class="editorial-thumb story-thumb" role="img" aria-label={story.category==='Bathroom'?'A considered compact bathroom interior':story.slug==='under-sink-storage'?'Practical storage arranged around visible sink plumbing':story.slug==='pantry-organization-system'?'A well-organized pantry with visible food categories':'Neutral storage solutions for flexible small spaces'} style={`background-position:${storyPositions[story.slug] || '0 0'}`}>
              <span class="thumb-index">0{i+1}</span>
            </div>
            <p class="eyebrow">{story.category} · EDITORIAL GUIDE</p>
            <h3>{story.title}</h3>
            <p class="story-excerpt">{story.excerpt}</p>
            <span class="read-time">{story.read}</span>
          </a>
        </article>)}
      </div>
    </section>

    <section class="rooms-section" aria-labelledby="rooms-title">
      <div class="wrap">
        <div class="section-head">
          <div><p class="eyebrow">Find your starting point</p><h2 id="rooms-title">Explore by room</h2></div>
          <a class="text-link" href="/categories">View all spaces ↗</a>
        </div>
        <div class="room-grid">
          {rooms.map((room,i)=><a class="room-card" href={room.href}>
            <div class="editorial-thumb room-thumb" role="img" aria-label={room.name+' interior inspiration'} style={`background-position:${room.position}`}>
              <span class="room-number">0{i+1}</span><span class="room-overlay">{room.name} <b>↗</b></span>
            </div>
            <div class="room-copy"><h3>{room.name}</h3><p>{room.desc}</p></div>
          </a>)}
        </div>
      </div>
    </section>

    <section class="edit-strip">
      <div class="wrap edit-inner">
        <div class="edit-copy">
          <p class="eyebrow">The Trove Edit</p>
          <h2>Useful pieces<br/><em>deserve a place.</em></h2>
          <p>Discover considered finds chosen for their usefulness, fit and everyday value. We look beyond the pretty picture to ask what a product solves, where it works and where it may not.</p>
          <a class="button button-light" href="/the-edit">Explore The Edit <span>↗</span></a>
        </div>
        <div class="edit-visual" role="img" aria-label="A considered arrangement of natural home materials, storage and useful everyday details">
          <span>FIT &amp; FUNCTION</span><span>MATERIALS &amp; CARE</span><span>LIMITS &amp; TRADE-OFFS</span>
        </div>
      </div>
    </section>

    <section class="philosophy wrap">
      <p class="eyebrow">Our point of view</p>
      <h2>A better home isn't about buying more.</h2>
      <p>It is about making thoughtful choices about what earns a place in your space. We believe useful advice should help you make a better decision—even when that decision is to buy nothing at all.</p>
      <a class="text-link" href="/how-we-choose">How We Choose ↗</a>
    </section>
  </main>
  {publishedArticles.length > 0 && <section class="section wrap live-journal"><div class="section-head"><div><p class="eyebrow">Fresh from the studio</p><h2>Recently published</h2></div><a class="text-link" href="/journal">All journal stories ↗</a></div><div class="live-journal-grid">{publishedArticles.slice(0,3).map(article=><article><p class="eyebrow">{article.category?.name || 'HOME & LIVING'}</p><h3><a href={'/journal/'+article.slug}>{article.title}</a></h3><p>{article.excerpt}</p><a class="text-link" href={'/journal/'+article.slug}>Read story ↗</a></article>)}</div></section>}
  <footer class="footer">
    <div class="wrap footer-top">
      <div class="footer-brand-lockup"><a class="footer-brand-mark" href="/" aria-label="Trove & Tier home"><img src="/images/brand/trove-tier-logo.png" alt="Trove & Tier geometric monogram" width="64" height="64" loading="lazy"/></a><p class="footer-tagline">Thoughtful finds. Better living.</p><span class="footer-descriptor">HOME &amp; LIVING</span></div>
      <div class="footer-links"><a href="/about">About</a><a href="/journal">Journal</a><a href="/how-we-choose">How we choose</a><a href="/contact">Contact</a><a href="/affiliate-disclosure">Affiliate disclosure</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div>
    </div>
    <div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Trove &amp; Tier</span><span>Made for living well.</span></div>
  </footer>
</BaseLayout>
<style>
.wrap{max-width:var(--content-width);margin:auto;padding-left:5%;padding-right:5%}
.eyebrow{font-size:9px;letter-spacing:.19em;text-transform:uppercase;color:var(--color-deep-sage);font-weight:600;margin:0}
.hero{padding-top:56px;padding-bottom:62px;display:grid;grid-template-columns:.78fr 1.22fr;gap:clamp(28px,5vw,70px);align-items:center}
.hero-copy{padding:18px 0}.hero h1{font:clamp(58px,6.4vw,88px)/.91 var(--font-display);letter-spacing:-.035em;margin:24px 0}.hero h1 em,h2 em{font-weight:400;color:var(--color-deep-sage)}
.intro{max-width:390px;font:clamp(14px,1.2vw,16px)/1.75 var(--font-body);color:#62645b}
.hero-actions{display:flex;flex-wrap:wrap;gap:10px}.button{display:inline-flex;gap:26px;align-items:center;background:var(--color-deep-sage);color:#fff;text-decoration:none;padding:14px 17px;font-size:10px;letter-spacing:.04em;margin-top:18px;transition:background .2s ease,transform .2s ease}.button:hover{background:var(--color-charcoal);transform:translateY(-2px)}.button span{font-size:15px}.button-outline{background:transparent;color:var(--color-charcoal);border:1px solid var(--color-charcoal)}.button-outline:hover{background:var(--color-charcoal);color:#fff}.hero-photo{height:clamp(320px,39vw,500px);position:relative;overflow:hidden;background:#d4cbbd}.hero-photo img{width:100%;height:100%;object-fit:cover;object-position:center 55%;display:block}.photo-caption{position:absolute;bottom:16px;right:18px;background:rgba(233,226,215,.9);padding:8px 10px;font-size:8px;letter-spacing:.15em}.hero-note{font-size:8px;letter-spacing:.16em;margin-top:30px;color:#77776e}
.journal-feature{padding-top:48px;padding-bottom:84px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px}.section-head h2{font:clamp(42px,5vw,62px)/.95 var(--font-display);letter-spacing:-.025em;margin:10px 0 0}.text-link{font-size:10px;text-decoration:none;border-bottom:1px solid var(--color-stone);padding-bottom:7px;white-space:nowrap}.text-link:hover{border-color:var(--color-deep-sage)}
.journal-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.journal-card{min-width:0}.journal-card-main{display:block;text-decoration:none;color:inherit}.editorial-thumb{position:relative;background-image:url('/images/editorial/editorial-image-atlas.webp');background-repeat:no-repeat;background-size:800px 338px;background-color:#d8d0c3;overflow:hidden}.story-thumb{aspect-ratio:1.75/1;width:100%;}.thumb-index{position:absolute;right:10px;bottom:8px;color:white;text-shadow:0 1px 5px rgba(0,0,0,.5);font:25px var(--font-display)}.journal-card .eyebrow{font-size:8px;margin:14px 0 8px}.journal-card h3{font:clamp(20px,2vw,27px)/1.04 var(--font-display);margin:0 0 8px}.story-excerpt{font-size:10px;line-height:1.65;color:#66685f;margin:0}.read-time{display:block;font-size:9px;color:#77776e;margin-top:10px}
.rooms-section{background:#f1ece3;padding:78px 0 88px}.room-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px 18px}.room-card{text-decoration:none;min-width:0}.room-thumb{aspect-ratio:1.75/1;width:100%}.room-number{position:absolute;top:10px;left:12px;color:#fff;font:20px var(--font-display;text-shadow:0 1px 5px rgba(0,0,0,.45)}.room-overlay{position:absolute;bottom:0;left:0;right:0;display:flex;justify-content:space-between;align-items:center;padding:12px 14px;background:linear-gradient(transparent,rgba(28,29,25,.72));color:#fff;font:23px var(--font-display)}.room-overlay b{font:15px var(--font-body)}.room-copy h3{font:24px var(--font-display);margin:11px 0 3px}.room-copy p{font-size:10px;color:#66685f;margin:0;line-height:1.6}
.edit-strip{background:var(--color-charcoal);color:var(--color-ivory);padding:78px 0}.edit-inner{display:grid;grid-template-columns:.85fr 1.15fr;gap:10%;align-items:center}.edit-copy .eyebrow{color:#c4c9b9}.edit-copy h2{font:clamp(48px,5.8vw,76px)/.96 var(--font-display);margin:14px 0}.edit-copy h2 em{color:#c7cdbd}.edit-copy>p:not(.eyebrow){color:#d0ccc2;font-size:12px;line-height:1.8;max-width:390px}.button-light{background:var(--color-ivory);color:var(--color-charcoal)}.button-light:hover{background:#fff;color:var(--color-charcoal)}
.edit-visual{min-height:300px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;align-items:center}.edit-visual span{min-height:210px;padding:12px;display:flex;align-items:end;background:#b9b19f;color:#33352f;font-size:8px;letter-spacing:.12em}.edit-visual span:nth-child(2){margin-top:35px;background:#8b9482}.edit-visual span:nth-child(3){margin-top:-22px;background:#c7bdae}
.philosophy{padding-top:92px;padding-bottom:100px;text-align:center;max-width:900px}.philosophy h2{font:clamp(42px,5.5vw,68px)/1 var(--font-display);margin:18px auto}.philosophy>p:not(.eyebrow){font:clamp(15px,1.4vw,18px)/1.8 var(--font-display);max-width:700px;margin:0 auto 22px;color:#5f6158}
.live-journal{padding-top:0;padding-bottom:70px}.live-journal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.live-journal-grid article{border-top:1px solid var(--line);padding:18px 0}.live-journal-grid h3{font:28px/1.05 var(--font-display);margin:12px 0}.live-journal-grid h3 a{text-decoration:none}.live-journal-grid article>p:not(.eyebrow){font-size:12px;line-height:1.7;color:#66685f}
.footer{background:#33352f;color:#e9e2d7;padding:48px 0 20px}.footer-top,.footer-bottom{display:flex;justify-content:space-between;gap:30px}.footer-brand-lockup{display:flex;flex-direction:column;align-items:flex-start;gap:4px}.footer-brand-mark img{display:block;width:64px;height:64px;object-fit:contain}.footer-tagline{font:23px/1.1 var(--font-display);color:#e9e2d7;margin:5px 0 0}.footer-descriptor{font:8px var(--font-body);letter-spacing:.24em;color:#c2c0b7}.footer-links{display:grid;grid-template-columns:repeat(2,auto);gap:13px 30px;align-content:start}.footer-links a,.footer-bottom{font-size:10px;text-decoration:none;color:#e9e2d7}.footer-bottom{border-top:1px solid #65665f;margin-top:40px;padding-top:16px;color:#c2c0b7}
@media(max-width:900px){.hero{grid-template-columns:.9fr 1.1fr;gap:25px}.journal-grid{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:30px}.room-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:650px){.hero{grid-template-columns:1fr;padding-top:36px;padding-bottom:44px;gap:22px}.hero-copy{padding:0}.hero h1{font-size:64px;margin:16px 0}.hero-photo{height:300px;grid-row:1}.hero-note{margin-top:18px}.journal-feature{padding-top:38px;padding-bottom:58px}.section-head{align-items:start;flex-direction:column;gap:12px}.journal-grid{gap:28px 14px}.journal-card h3{font-size:23px}.rooms-section{padding:58px 0}.room-grid{gap:22px 12px}.room-copy h3{font-size:21px}.edit-inner{grid-template-columns:1fr;gap:28px}.edit-strip{padding:58px 0}.edit-visual{min-height:220px}.edit-visual span{min-height:170px}.philosophy{padding-top:65px;padding-bottom:70px}.live-journal-grid{grid-template-columns:1fr}.footer-top{flex-direction:column}.footer-links{grid-template-columns:repeat(2,1fr)}}
@media(max-width:390px){.hero h1{font-size:56px}.journal-grid{grid-template-columns:1fr}.story-thumb{aspect-ratio:1.8/1}.room-thumb{aspect-ratio:1.45/1}.room-overlay{font-size:20px}.edit-visual{gap:6px}.edit-visual span{font-size:7px;padding:8px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}
</style>