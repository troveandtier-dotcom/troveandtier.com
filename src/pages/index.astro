---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { editorialTerritories, roomCategories, articles, fullManuscriptSlugs } from '../data/site';
import { getPublishedArticles } from '../lib/public-content';
const publishedArticles = await getPublishedArticles();
const featuredSlugs = ['under-sink-storage','pantry-organization-system','small-bathroom-storage','no-drill-storage'];
const featuredStories = featuredSlugs.flatMap((slug) => {
  const article = articles.find(item => item.slug === slug);
  const image = ({
    'under-sink-storage': '/editorial/under-sink-storage.webp',
    'pantry-organization-system': '/editorial/pantry-organization.webp',
    'small-bathroom-storage': '/editorial/small-bathroom.webp',
    'no-drill-storage': '/editorial/no-drill-storage.webp'
  } as Record<string,string>)[slug];
  return article && fullManuscriptSlugs.includes(slug) && !publishedArticles.some(live => live.slug === slug)
    ? [{ ...article, image }]
    : [];
});
const rooms = [
  {name:'Kitchen',desc:'Planning, materials and practical details.',image:'/rooms/room-kitchen.webp',slug:'kitchen'},
  {name:'Bathroom',desc:'A more considered start and finish to the day.',image:'/rooms/room-bathroom.webp',slug:'bathroom'},
  {name:'Bedroom',desc:'Restful spaces and everyday essentials.',image:'/rooms/room-bedroom.webp',slug:'bedroom'},
  {name:'Small spaces',desc:'Make considered use of every metre.',image:'/rooms/room-small-spaces.webp',slug:'small-spaces'}
];
---
<BaseLayout title="Trove & Tier — Thoughtful finds. Better living." description="A considered world of interiors, architecture, exceptional objects, home experiences and practical ideas for better living.">
  <Header/>
  <main>
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow">A considered world of home &amp; living</p>
        <h1>Thoughtful finds.<br/><em>Better living.</em></h1>
        <p class="intro">Considered interiors, exceptional objects and experiences that make a home feel more like your own. From the everyday upgrade to the extraordinary address, discover a more thoughtful way to live.</p>
        <div class="hero-actions"><a class="button" href="/categories">Explore our world <span>↗</span></a><a class="quiet-link" href="/journal">Read the journal</a></div>
      </div>
      <div class="hero-art"><img src="/editorial/homepage-kitchen-hero.webp" alt="Warm, naturally lit kitchen with oak cabinetry and a pale stone worktop" width="1600" height="1067" fetchpriority="high" decoding="async"/><span class="image-note">THE WORLD OF HOME, CONSIDERED</span></div>
      <div class="hero-foot"><span>THE TROVE &amp; TIER POINT OF VIEW</span><span>01 — 05</span></div>
    </section>

    <section class="territory-section wrap" id="explore">
      <div class="section-head"><div><p class="eyebrow">Five editorial territories</p><h2>A wider view<br/><em>of living.</em></h2></div><p>Not simply rooms or products. The spaces, objects, experiences, rituals and places that shape the way we live.</p></div>
      <div class="territory-grid">
        {editorialTerritories.map((territory,i)=><a class="territory-card" href={'/'+territory.slug}><span class="number">0{i+1}</span><div><p class="eyebrow">{territory.navTitle}</p><h3>{territory.title}</h3><p>{territory.intro}</p><b>Explore ↗</b></div></a>)}
      </div>
    </section>

    <section class="feature-band"><div class="wrap feature-inner"><p class="eyebrow">A point of view, not a shopping list</p><div class="feature-grid"><h2>Live well.<br/><em>Choose well.</em></h2><div><p>We look beyond the photograph. How is a piece made? What does a room ask of us? Which details make technology feel effortless? What deserves the space it occupies?</p><a class="text-link" href="/about">Discover our point of view ↗</a></div></div></div></section>

    <section class="section wrap rooms-section">
      <div class="section-head"><div><p class="eyebrow">The practical side of better living</p><h2>Start with a room.</h2></div><a class="text-link" href="/categories">All rooms and territories ↗</a></div>
      <div class="room-grid">{rooms.map((room,i)=><a class="room-card" href={'/'+room.slug}><div class="room-visual"><img src={room.image} alt={room.name+' interior inspiration'} width="900" height="600" loading="lazy" decoding="async"/><span>0{i+1}</span></div><div class="room-copy"><h3>{room.name}</h3><p>{room.desc}</p></div><span class="arrow">↗</span></a>)}</div>
    </section>

    <section class="edit-strip"><div class="wrap edit-inner"><div><p class="eyebrow">The Trove Edit</p><h2>Considered finds.<br/><em>Chosen with care.</em></h2><p>Our product edit is being developed around fit, function, materials, care and honest trade-offs. We will only feature selections when the details and regional retailer information are ready.</p><a class="button button-light" href="/the-edit">Explore the edit <span>↗</span></a></div><div class="edit-statement"><span>FIT &amp; FUNCTION</span><span>MATERIALS &amp; CARE</span><span>CONTEXT &amp; CRAFT</span><span>LIMITS &amp; TRADE-OFFS</span></div></div></section>

    <section class="section wrap journal-section">
      <div class="section-head"><div><p class="eyebrow">Ideas, perspective and practical guidance</p><h2>From the journal.</h2></div><a class="text-link" href="/journal">Visit the journal ↗</a></div>
      <div class="journal-grid">
        {featuredStories.slice(0,3).map((story,i)=><article class="journal-card"><a href={'/journal/'+story.slug}><div class="journal-art"><img src={story.image} alt={story.title+' editorial image'} width="900" height="600" loading="lazy" decoding="async"/><span>0{i+1}</span></div><p class="eyebrow">{story.category} · {story.read}</p><h3>{story.title}</h3><p>{story.excerpt}</p><b>Read guide ↗</b></a></article>)}
        {publishedArticles.slice(0,3).map((article,i)=><article class="journal-card live"><a href={'/journal/'+article.slug}><div class="journal-art"><span class="live-label">FROM THE STUDIO</span></div><p class="eyebrow">{article.category?.name || 'HOME & LIVING'}</p><h3>{article.title}</h3><p>{article.excerpt}</p><b>Read story ↗</b></a></article>)}
      </div>
    </section>
  </main>
  <footer class="footer"><div class="wrap footer-top"><div class="footer-brand"><a href="/" aria-label="Trove & Tier home"><img src="/brand/trove-tier-logo.png" alt="Trove & Tier logo" width="58" height="58"/></a><p>Thoughtful finds. Better living.</p><span>HOME &amp; LIVING</span></div><div class="footer-links"><a href="/about">About</a><a href="/categories">Explore all territories</a><a href="/how-we-choose">How we choose</a><a href="/affiliate-disclosure">Affiliate disclosure</a><a href="/contact">Contact &amp; partnerships</a><a href="/privacy">Privacy</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Trove &amp; Tier</span><span>Made for living well.</span><a href="/terms">Terms</a></div></footer>
</BaseLayout>
<style>
.wrap{max-width:var(--content-width);margin:auto;padding-left:5%;padding-right:5%}.eyebrow{font-size:9px;letter-spacing:.19em;text-transform:uppercase;color:var(--color-deep-sage);font-weight:600}.hero{padding-top:68px;padding-bottom:24px;display:grid;grid-template-columns:.92fr 1.08fr;gap:42px;align-items:center;position:relative}.hero h1{font:clamp(58px,7vw,96px)/.94 var(--font-display);letter-spacing:-.04em;margin:27px 0}.hero h1 em,h2 em{font-weight:400;color:var(--color-deep-sage)}.intro{max-width:430px;font-size:14px;line-height:1.9;color:#62645b}.hero-actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap}.button{display:inline-flex;gap:35px;align-items:center;background:var(--color-deep-sage);color:#fff;text-decoration:none;padding:15px 18px;font-size:10px;letter-spacing:.04em;margin-top:18px}.button span{font-size:15px}.quiet-link,.text-link{font-size:10px;text-decoration:none;border-bottom:1px solid var(--color-stone);padding-bottom:7px;margin-top:18px}.hero-art{height:clamp(370px,42vw,540px);position:relative;overflow:hidden;background:#d4cbbd}.hero-art img{width:100%;height:100%;display:block;object-fit:cover;object-position:58% center}.image-note{position:absolute;bottom:16px;left:17px;color:white;font-size:8px;letter-spacing:.17em;text-shadow:0 1px 6px #333}.hero-foot{grid-column:1/-1;display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:14px;font-size:8px;letter-spacing:.16em;margin-top:16px}.territory-section,.section{padding-top:92px;padding-bottom:92px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:32px}.section-head h2,.feature-grid h2{font:clamp(43px,5.3vw,66px)/.96 var(--font-display);letter-spacing:-.025em;margin:12px 0 0}.section-head>p{font-size:12px;line-height:1.8;color:#62645b;max-width:360px}.territory-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.territory-card{min-height:225px;padding:19px;background:#f1ece3;text-decoration:none;display:grid;grid-template-columns:30px 1fr;gap:12px;position:relative}.territory-card:nth-child(2){background:#d9d3c8}.territory-card:nth-child(3){background:#d8d7c9}.territory-card:nth-child(4){background:#e2dbcf}.territory-card:nth-child(5){background:#d1c9bb}.territory-card .number{font:23px var(--font-display);color:var(--color-deep-sage)}.territory-card .eyebrow{margin:4px 0 12px}.territory-card h3{font:32px/1 var(--font-display);margin:0 0 10px}.territory-card div>p:not(.eyebrow){font-size:11px;line-height:1.7;color:#5f6158}.territory-card b{font-size:9px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;display:inline-block;margin-top:7px;border-bottom:1px solid var(--color-stone);padding-bottom:5px}.feature-band{background:#d9d3c8;padding:75px 0}.feature-inner>.eyebrow{margin:0 0 25px}.feature-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:10%;align-items:end}.feature-grid h2{font-size:clamp(58px,7vw,86px)}.feature-grid>div p,.edit-inner>div>p:not(.eyebrow){font-size:13px;line-height:1.9;color:#5f6158}.rooms-section{padding-top:86px}.room-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.room-card{text-decoration:none;position:relative}.room-visual{aspect-ratio:4/5;position:relative;overflow:hidden;background:#d8d2c7}.room-visual img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .35s ease}.room-card:hover img{transform:scale(1.025)}.room-visual span{position:absolute;top:13px;left:14px;color:#fff;font-size:9px;text-shadow:0 1px 5px #333}.room-copy h3{font:27px var(--font-display);margin:13px 0 3px}.room-copy p{font-size:10px;line-height:1.6;color:#66685f}.arrow{position:absolute;right:0;bottom:4px}.edit-strip{background:var(--color-charcoal);color:var(--color-ivory);padding:82px 0}.edit-inner{display:grid;grid-template-columns:1fr 1fr;gap:10%;align-items:center}.edit-inner .eyebrow{color:#c4c9b9}.edit-inner h2{font:clamp(48px,6vw,75px)/.96 var(--font-display);margin:15px 0}.edit-inner>div>p:not(.eyebrow){color:#c7c3b9;max-width:470px}.button-light{background:var(--color-ivory);color:var(--color-charcoal)}.edit-statement{border-top:1px solid #65665f}.edit-statement span{display:block;padding:17px 0;border-bottom:1px solid #65665f;font:23px var(--font-display);letter-spacing:.02em;color:#e9e2d7}.journal-section{padding-bottom:105px}.journal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px}.journal-card a{text-decoration:none;color:inherit}.journal-art{aspect-ratio:4/3;position:relative;overflow:hidden;background:#d8d2c7;margin-bottom:17px}.journal-art img{width:100%;height:100%;object-fit:cover;display:block}.journal-art>span{position:absolute;bottom:12px;right:14px;font:30px var(--font-display);color:white;text-shadow:0 1px 5px #333}.journal-card h3{font:27px/1.05 var(--font-display);margin:10px 0}.journal-card a>p:not(.eyebrow){font-size:11px;line-height:1.7;color:#66685f}.journal-card b{font-size:9px;letter-spacing:.1em;text-transform:uppercase;font-weight:500;color:var(--color-deep-sage);display:inline-block;margin-top:8px;border-bottom:1px solid var(--color-stone);padding-bottom:5px}.live .journal-art{background:#d9d3c8;display:flex;align-items:end;padding:16px}.live-label{font-size:8px;letter-spacing:.15em;color:var(--color-charcoal)}.footer{background:#33352f;color:#e9e2d7;padding:50px 0 20px}.footer-top,.footer-bottom{display:flex;justify-content:space-between;gap:30px}.footer-brand img{display:block;width:58px;height:58px;object-fit:contain}.footer-brand p{font:23px var(--font-display);margin:8px 0 2px}.footer-brand>span{font-size:8px;letter-spacing:.23em;color:#c2c0b7}.footer-links{display:grid;grid-template-columns:repeat(2,auto);gap:14px 30px;align-content:start}.footer-links a,.footer-bottom a{font-size:10px;text-decoration:none;color:#e9e2d7}.footer-bottom{border-top:1px solid #65665f;margin-top:40px;padding-top:17px;font-size:9px;color:#c2c0b7}
@media(max-width:850px){.hero{grid-template-columns:1fr;gap:25px}.hero-copy{max-width:650px}.hero-art{height:auto;aspect-ratio:4/3}.territory-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.room-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.feature-grid,.edit-inner{grid-template-columns:1fr;gap:22px}.journal-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.wrap{padding-left:5.5%;padding-right:5.5%}.hero{padding-top:42px}.hero h1{font-size:clamp(57px,13vw,70px)}.hero-art{aspect-ratio:1/1.05}.hero-foot{font-size:7px}.territory-section,.section{padding-top:65px;padding-bottom:65px}.section-head{align-items:flex-start;flex-direction:column;gap:5px}.territory-grid,.room-grid,.journal-grid{grid-template-columns:1fr}.territory-card{min-height:200px}.room-visual{aspect-ratio:16/10}.edit-strip{padding:65px 0}.edit-statement span{font-size:21px}.footer-top{flex-direction:column}.footer-links{grid-template-columns:1fr 1fr}.footer-bottom{flex-wrap:wrap;gap:12px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}
