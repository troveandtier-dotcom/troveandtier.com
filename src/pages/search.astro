---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import { categories, articles } from '../data/site';
const records=[...categories.map(c=>({title:c.title,description:c.intro,url:'/'+c.slug,type:'Room'})),...articles.map(a=>({title:a.title,description:a.excerpt,url:'/journal/'+a.slug,type:'Guide'}))];
---
<BaseLayout title="Search — Trove & Tier" description="Search Trove & Tier room guides and editorial ideas."><Header/><main class="wrap"><p class="eyebrow">Find something useful</p><h1>What are you<br/><em>looking for?</em></h1><label class="searchbox"><span class="sr-only">Search Trove & Tier</span><input id="q" type="search" placeholder="Try “small kitchen” or “wardrobe”" autocomplete="off"/><span>⌕</span></label><p id="count" class="count" aria-live="polite">Explore rooms and editorial guides.</p><div id="results" class="results">{records.map(r=><a class="result" href={r.url} data-search={(r.title+' '+r.description+' '+r.type).toLowerCase()}><small>{r.type}</small><h2>{r.title}</h2><p>{r.description}</p><b>Explore ↗</b></a>)}</div></main><footer><a href="/">TROVE &amp; TIER</a><span>Thoughtful finds. Better living.</span></footer></BaseLayout>
<script>
const input=document.querySelector<HTMLInputElement>('#q');
const results=document.querySelectorAll<HTMLElement>('.result');
const count=document.querySelector<HTMLElement>('#count');
input?.addEventListener('input',()=>{
 const term=input.value.trim().toLowerCase(); let visible=0;
 results.forEach(item=>{const match=!term||((item.dataset.search||'').includes(term));item.hidden=!match;if(match)visible++});
 if(count)count.textContent=term?visible+' matching '+(visible===1?'result':'results')+'.': 'Explore rooms and editorial guides.';
});
</script>
<style>.wrap{max-width:1160px;margin:auto;padding:80px 5% 110px}.eyebrow{font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--color-deep-sage)}h1{font:clamp(62px,9vw,105px)/.9 var(--font-display);margin:25px 0 45px}h1 em{font-weight:400;color:var(--color-deep-sage)}.searchbox{max-width:750px;display:flex;border-bottom:1px solid var(--color-charcoal);align-items:center}.searchbox input{flex:1;min-width:0;background:transparent;border:0;padding:18px 0;font:22px var(--font-display);outline:none}.searchbox span:last-child{font-size:28px}.count{font-size:10px;color:#66685f;margin:25px 0}.results{max-width:850px}.result{display:block;border-top:1px solid var(--line);padding:20px 0;text-decoration:none}.result small{font-size:9px;letter-spacing:.14em;color:var(--color-deep-sage);text-transform:uppercase}.result h2{font:30px var(--font-display);margin:7px 0}.result p{font-size:12px;line-height:1.7;color:#62645b;max-width:680px}.result b{font-size:10px;font-weight:500}.result[hidden]{display:none}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}footer{background:var(--color-charcoal);color:var(--color-ivory);padding:25px 5%;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.15em}footer a{color:inherit;text-decoration:none}@media(max-width:600px){footer{flex-direction:column;gap:10px}}</style>
