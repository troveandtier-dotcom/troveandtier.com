---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { articles } from '../../data/site';
import { getPublishedArticles, markdownToSafeHtml } from '../../lib/public-content';
import underSinkManuscript from '../../content/articles/under-sink-storage.md?raw';
import pantryManuscript from '../../content/articles/pantry-organization-system.md?raw';
export async function getStaticPaths(){
 const published = await getPublishedArticles();
 const fallback = articles.filter(item => !published.some(entry => entry.slug === item.slug));
 return [
  ...published.map(article => ({params:{slug:article.slug},props:{article,fromDatabase:true}})),
  ...fallback.map(article => ({params:{slug:article.slug},props:{article,fromDatabase:false}}))
 ];
}
const { article, fromDatabase } = Astro.props;
const databaseArticle = fromDatabase ? article as import('../../lib/public-content').PublishedArticle : null;
const staticArticle = fromDatabase ? null : article as typeof articles[number];
const isUnderSink = staticArticle?.slug === 'under-sink-storage';
const isPantry = staticArticle?.slug === 'pantry-organization-system';
const stripFrontmatterAndTitle = (source: string) => source.replace(/^---[\s\S]*?---\s*/, '').replace(/^# .+\n+/, '');
const manuscriptMarkdown = isUnderSink ? stripFrontmatterAndTitle(underSinkManuscript) : isPantry ? stripFrontmatterAndTitle(pantryManuscript) : null;
const safeBodyHtml = databaseArticle ? markdownToSafeHtml(databaseArticle.body_markdown || '') : manuscriptMarkdown ? markdownToSafeHtml(manuscriptMarkdown) : null;
const categoryLabel = databaseArticle ? databaseArticle.category?.name : staticArticle?.category;
const articleType = databaseArticle ? databaseArticle.content_type : 'Guide';
const byline = isPantry ? 'Trove & Tier Editors' : null;
const readLabel = databaseArticle ? 'Editorial' : staticArticle?.read || '';
const pageTitle = databaseArticle?.seo_title || (isUnderSink ? 'Under-Sink Storage: Measure the Pipes First' : isPantry ? 'Pantry Organization That Actually Stays Organized' : article.title + ' — Trove & Tier');
const pageDescription = databaseArticle?.seo_description || (isUnderSink ? 'Plan under-sink storage around pipes, valves and damp: what to measure, which shapes work, and how to store cleaning products safely.' : isPantry ? 'Build a pantry around rotation, not containers: audit what you own, check storage conditions, group by use, and understand what dates really mean.' : article.excerpt);
const sections: Record<string,{intro:string;steps:string[];close:string}> = {
 'small-kitchen-planning': {intro:'Before choosing containers, racks or organizers, understand what your kitchen needs to do. A useful plan starts with your habits, the space you actually have and the things you reach for most.',steps:['Notice the friction points. Which cupboard is hard to reach? Where do everyday items collect? What interrupts meal preparation?','Measure the usable space. Record shelf width, depth and height, note hinges and obstructions, and check how doors and drawers open.','Group by routine. Keep frequently used cooking, preparation and serving items close to the places where those tasks happen.','Choose a system only after the problem is clear. A product should solve a specific access, visibility or capacity issue—not simply add another container.'],close:'The best small-kitchen solution is the one that makes your own routine easier without making the room harder to maintain.'},
 'closet-reset': {intro:'A wardrobe reset does not need to happen all at once. Working through one zone at a time makes it easier to see what you own and which storage problems actually need solving.',steps:['Choose one zone: hanging clothes, a drawer, a shelf or accessories. Avoid emptying the entire wardrobe if you cannot finish in one session.','Group items by how you use them. Keep everyday pieces easiest to reach and store occasional items where they remain accessible.','Measure before adding organizers. Check drawer interior dimensions, shelf clearance and hanging height.','Review the result after a week. Adjust the system based on what you actually reach for, not an idealized picture.'],close:'The goal is a wardrobe that supports your routine and is simple to reset—not a perfect-looking closet that is difficult to maintain.'}
};
const body=sections[article.slug];
---
<BaseLayout title={pageTitle} description={pageDescription}>
<Header />
<main class="wrap">
  <article class="story">
    <a class="back" href="/journal">← Back to the journal</a>
    <p class="eyebrow">{categoryLabel || 'Home & Living'} / {articleType} / {readLabel}</p>
    <h1>{article.title}</h1><p class="dek">{article.excerpt}</p>{byline && <p class="byline">By {byline}</p>}
    <div class="story-rule"><span>TROVE &amp; TIER</span><span>THOUGHTFUL FINDS. BETTER LIVING.</span></div>
    <div class="story-body">{databaseArticle || isUnderSink || isPantry ? <div class="cms-body" set:html={safeBodyHtml} /> : <><p>{body.intro}</p><h2>A practical place to begin</h2><ol>{body.steps.map(step=><li>{step}</li>)}</ol><h2>Keep the goal simple</h2><p>{body.close}</p></>}<aside><strong>Our editorial approach</strong><p>This guide offers general home-organization ideas. Product specifications, prices and availability are not asserted here. When we recommend specific products, we will identify the market, retailer and date the details were checked.</p><a href="/how-we-choose">How we choose recommendations ↗</a></aside></div>
  </article>
</main>
<footer><a href="/">TROVE &amp; TIER</a><span>THOUGHTFUL FINDS. BETTER LIVING.</span></footer>
</BaseLayout>
<style>
.cms-body :global(p){margin:0 0 1.25em}.cms-body :global(h2),.cms-body :global(h3){font:36px var(--font-display);margin:42px 0 14px;color:var(--color-charcoal)}.cms-body :global(ul),.cms-body :global(ol){padding-left:24px}.cms-body :global(li){padding:0 0 12px 8px}.cms-body :global(a){color:var(--color-deep-sage);text-decoration:underline}.cms-body :global(strong){font-weight:700}.cms-body :global(.table-scroll){overflow-x:auto;margin:24px 0}.cms-body :global(table){border-collapse:collapse;width:100%;font-size:12px;line-height:1.6}.cms-body :global(th),.cms-body :global(td){padding:10px 12px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}.cms-body :global(th){color:var(--color-charcoal);background:#f2ede4}
.wrap{max-width:1160px;margin:auto;padding:0 5%}.story{padding:55px 0 100px}.back{font-size:10px;text-decoration:none}.eyebrow{font-size:9px;letter-spacing:.17em;text-transform:uppercase;color:var(--color-deep-sage);margin-top:55px}h1{font:clamp(56px,8vw,96px)/.92 var(--font-display);letter-spacing:-.035em;max-width:900px;margin:20px 0}.dek{font-size:16px;line-height:1.8;max-width:700px;color:#62645b}.byline{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--color-deep-sage);margin-top:18px}.story-rule{display:flex;justify-content:space-between;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:13px 0;margin:45px 0 55px;font-size:8px;letter-spacing:.15em}.story-body{max-width:720px;margin:auto;font-size:14px;line-height:1.95;color:#4f514a}.story-body>p:first-child{font:24px/1.5 var(--font-display);color:var(--color-charcoal)}.story-body h2{font:36px var(--font-display);margin:42px 0 14px;color:var(--color-charcoal)}.story-body li{padding:0 0 15px 8px}.story-body aside{background:#f2ede4;padding:24px;margin-top:45px;font-size:12px}.story-body aside p{margin:8px 0}.story-body aside a{color:var(--color-deep-sage)}footer{background:var(--color-charcoal);color:var(--color-ivory);padding:28px 5%;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.12em}footer a{color:inherit;text-decoration:none}@media(max-width:600px){.story{padding-top:35px}.story-rule{gap:10px;font-size:7px}.story-body{font-size:13px}footer{flex-direction:column;gap:10px}}
</style>
