---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { categories, articles } from '../data/site';
export function getStaticPaths() {
  return categories.map(category => ({ params: { category: category.slug }, props: { category } }));
}
const { category } = Astro.props;
const related = articles.filter(article => article.category === category.title);
---
<BaseLayout title={category.title + ' ideas — Trove & Tier'} description={category.intro}>
  <Header />
  <main>
    <section class="intro wrap"><p class="eyebrow">Explore the home / {category.title}</p><h1>{category.title}<br/><em>with intention.</em></h1><p>{category.intro}</p></section>
    <section class="wrap content">
      <div class="focus"><p class="eyebrow">Explore this space</p><h2>Start with what matters.</h2><ul>{category.focus.map(item=><li>{item}<span>↗</span></li>)}</ul></div>
      <div class="guides"><p class="eyebrow">From the journal</p><h2>Ideas to make it work better.</h2>{related.length ? related.map(article=><a class="guide" href={'/journal/'+article.slug}><small>{article.category} · {article.read}</small><h3>{article.title}</h3><p>{article.excerpt}</p><span>Read the guide ↗</span></a>) : <div class="empty"><h3>More considered ideas are on the way.</h3><p>We're developing practical guides for this space. We won't fill this page with unverified product picks or placeholder recommendations.</p><a href="/journal">Explore the journal ↗</a></div>}</div>
    </section>
  </main>
  <footer class="foot"><a href="/">TROVE &amp; TIER</a><span>Thoughtful finds. Better living.</span></footer>
</BaseLayout>
<style>
.wrap{max-width:1160px;margin:auto;padding-left:5%;padding-right:5%}.intro{padding-top:90px;padding-bottom:80px;border-bottom:1px solid var(--line)}.eyebrow{font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--color-deep-sage)}h1{font:clamp(65px,9vw,112px)/.88 var(--font-display);letter-spacing:-.035em;margin:28px 0}h1 em{color:var(--color-deep-sage);font-weight:400}.intro>p:last-child{max-width:540px;font-size:14px;line-height:1.85;color:#62645b}.content{display:grid;grid-template-columns:.8fr 1.2fr;gap:12%;padding-top:70px;padding-bottom:100px}.content h2{font:42px/.98 var(--font-display);margin:14px 0 28px}.focus ul{list-style:none;padding:0;border-top:1px solid var(--line)}.focus li{padding:17px 0;border-bottom:1px solid var(--line);font-size:12px;display:flex;justify-content:space-between;gap:16px}.focus li span{color:var(--color-deep-sage)}.guide{display:block;padding:22px 0;border-top:1px solid var(--line);text-decoration:none}.guide small,.guide span{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--color-deep-sage)}.guide h3,.empty h3{font:30px/1.05 var(--font-display);margin:10px 0}.guide p,.empty p{font-size:12px;line-height:1.75;color:#66685f}.empty{padding:24px;background:#f1ece3}.empty a{font-size:11px}.foot{background:var(--color-charcoal);color:var(--color-ivory);padding:28px 5%;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.12em}.foot a{text-decoration:none}@media(max-width:700px){.intro{padding-top:60px;padding-bottom:55px}.content{grid-template-columns:1fr;gap:55px}.foot{flex-direction:column;gap:10px}}
