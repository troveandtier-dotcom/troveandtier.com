import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro';
---
<BaseLayout title="About Trove & Tier" description="A considered home and living publication for thoughtful finds and better everyday spaces."><Header/><main class="wrap"><p class="eyebrow">A little about us</p><h1>The home is<br/><em>always evolving.</em></h1><div class="copy"><p class="lead">Trove &amp; Tier is a home and living publication for people who want their spaces to work well and feel considered.</p><p>We bring together practical ideas, useful guides and carefully researched product discovery across the kitchen, bathroom, bedroom, closet, laundry and small-space living.</p><p>Our point of view is simple: a home does not need more things for the sake of it. It needs the right ideas, useful details and choices that earn their place.</p><h2>Thoughtful finds. Better living.</h2><p>We serve readers in the United States, United Kingdom and Canada, with market-aware recommendations and clear information about retailer availability, pricing and product details.</p></div></main><footer><a href="/">TROVE &amp; TIER</a><span>HOME &amp; LIVING</span></footer></BaseLayout>
<style>.wrap{max-width:1100px;margin:auto;padding:80px 5% 110px}.eyebrow{font-size:9px;letter-spacing:.18em;color:var(--color-deep-sage);text-transform:uppercase}h1{font:clamp(65px,9vw,110px)/.9 var(--font-display);margin:28px 0 55px}h1 em{color:var(--color-deep-sage);font-weight:400}.copy{max-width:680px;margin-left:auto;font-size:14px;line-height:1.95;color:#5f6158}.lead{font:28px/1.4 var(--font-display);color:var(--color-charcoal)}h2{font:40px var(--font-display);color:var(--color-charcoal);margin-top:45px}footer{background:var(--color-charcoal);color:var(--color-ivory);padding:25px 5%;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.15em}footer a{color:inherit;text-decoration:none}</style>
