---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro';
---
<BaseLayout title="Affiliate disclosure — Trove & Tier"><Header/><main class="wrap"><p class="eyebrow">Transparency matters</p><h1>Affiliate<br/><em>disclosure.</em></h1><div class="copy"><p>Trove &amp; Tier may use affiliate links in editorial content and product recommendations. If you click an affiliate link and make a qualifying purchase, we may receive a commission at no additional cost to you.</p><p>Affiliate relationships help support our publication. They do not mean that a product has been independently tested, that a retailer endorses us, or that every recommendation is sponsored.</p><p>Where content is sponsored, gifted or otherwise commercially supported, we will label that relationship clearly.</p><p>We aim to explain the basis for product information, including manufacturer specifications, editorial research and any hands-on testing. Please review the retailer's current price, terms, shipping and availability before purchasing.</p><p>Questions about a commercial relationship? <a href="/contact">Contact us.</a></p></div></main><footer><a href="/">TROVE &amp; TIER</a><span>HOME &amp; LIVING</span></footer></BaseLayout>
<style>.wrap{max-width:1000px;margin:auto;padding:80px 5% 110px}.eyebrow{font-size:9px;letter-spacing:.18em;color:var(--color-deep-sage);text-transform:uppercase}h1{font:clamp(65px,9vw,110px)/.9 var(--font-display);margin:25px 0 55px}h1 em{color:var(--color-deep-sage);font-weight:400}.copy{max-width:680px;margin-left:auto;font-size:14px;line-height:1.95;color:#5f6158}.copy a{color:var(--color-deep-sage)}footer{background:var(--color-charcoal);color:var(--color-ivory);padding:25px 5%;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.15em}footer a{color:inherit;text-decoration:none}</style>
