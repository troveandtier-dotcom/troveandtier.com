---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { editorialTerritories, roomCategories } from '../data/site';
---
<BaseLayout title="Explore the world of home — Trove & Tier" description="Explore interiors, architecture, design objects, home technology and the rituals and places that shape better living.">
<Header/>
<main class="wrap">
  <header class="intro"><p class="eyebrow">The Trove &amp; Tier world</p><h1>Explore the<br/><em>considered home.</em></h1><p class="lead">Five editorial territories. One point of view: thoughtful finds, better living.</p></header>
  <section class="territories" aria-labelledby="territories-heading">
    <div class="section-head"><div><p class="eyebrow">Our editorial territories</p><h2 id="territories-heading">A wider view of living.</h2></div><p>From the spaces we inhabit to the objects, technology and rituals that make them our own.</p></div>
    <div class="territory-grid">{editorialTerritories.map((territory,i)=><a class="territory-card" href={'/'+territory.slug}><span class="number">0{i+1}</span><div><p class="eyebrow">{territory.navTitle}</p><h3>{territory.title}</h3><p>{territory.intro}</p><b>Explore territory ↗</b></div><span class="line">{territory.line}</span></a>)}</div>
  </section>
  <section class="rooms" aria-labelledby="rooms-heading"><div class="section-head"><div><p class="eyebrow">Practical room guides</p><h2 id="rooms-heading">Start with a space.</h2></div><p>Our practical guides remain part of the publication — useful, specific and grounded in the realities of a home.</p></div><div class="room-grid">{roomCategories.filter(room=>room.slug!=='the-edit').map((room,i)=><a href={'/'+room.slug}><span>0{i+1}</span><h3>{room.title}</h3><p>{room.intro}</p><b>Explore room ↗</b></a>)}</div></section>
</main>
<footer><a href="/">TROVE &amp; TIER</a><span>Thoughtful finds. Better living.</span></footer>
</BaseLayout>
<style>
.wrap{max-width:1160px;margin:auto;padding:0 5%}.eyebrow{font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--color-deep-sage)}.intro{padding:82px 0 70px;border-bottom:1px solid var(--line)}h1{font:clamp(65px,9vw,108px)/.9 var(--font-display);letter-spacing:-.04em;margin:25px 0}h1 em{font-weight:400;color:var(--color-deep-sage)}.lead{font:25px/1.4 var(--font-display);max-width:570px;color:#5f6158}.territories,.rooms{padding:75px 0 90px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:30px}.section-head h2{font:clamp(38px,5vw,56px)/.98 var(--font-display);margin:10px 0 0}.section-head>p{max-width:350px;font-size:12px;line-height:1.8;color:#62645b}.territory-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.territory-card{min-height:245px;padding:22px;background:#f1ece3;text-decoration:none;display:grid;grid-template-columns:38px 1fr;gap:15px;position:relative;overflow:hidden}.territory-card:nth-child(2){background:#d9d3c8}.territory-card:nth-child(3){background:#d8d7c9}.territory-card:nth-child(4){background:#e2dbcf}.territory-card:nth-child(5){background:#d1c9bb}.number{font:25px var(--font-display);color:var(--color-deep-sage)}.territory-card .eyebrow{margin:3px 0 12px}.territory-card h3{font:37px/1 var(--font-display);margin:0 0 12px}.territory-card div>p:not(.eyebrow){font-size:12px;line-height:1.75;color:#5f6158;max-width:440px}.territory-card b,.room-grid b{font-size:9px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;display:inline-block;margin-top:12px;border-bottom:1px solid var(--color-stone);padding-bottom:5px}.territory-card .line{position:absolute;right:20px;bottom:18px;font:italic 16px var(--font-display);color:rgba(51,53,47,.62)}.room-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.room-grid a{min-height:180px;padding:20px;background:var(--color-paper);text-decoration:none;display:flex;flex-direction:column;align-items:flex-start}.room-grid a:nth-child(3n+2){background:#d8d7c9}.room-grid span{font-size:9px;letter-spacing:.12em;color:var(--color-deep-sage)}.room-grid h3{font:29px var(--font-display);margin:22px 0 5px}.room-grid p{font-size:11px;line-height:1.65;color:#62645b;margin:0}.room-grid b{margin-top:auto}footer{background:var(--color-charcoal);color:var(--color-ivory);padding:25px 5%;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.15em}footer a{color:inherit;text-decoration:none}
@media(max-width:680px){.intro{padding:60px 0}.section-head{align-items:flex-start;flex-direction:column;gap:6px}.territory-grid,.room-grid{grid-template-columns:1fr}.territory-card{min-height:220px}.territory-card .line{font-size:14px}.territories,.rooms{padding:60px 0}.room-grid a{min-height:155px}footer{flex-direction:column;gap:10px}}
</style>