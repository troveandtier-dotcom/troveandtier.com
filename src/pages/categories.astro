---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import { categories } from '../data/site';
---
<BaseLayout title="Explore rooms — Trove & Tier" description="Explore thoughtful ideas for every room and corner of your home."><Header/><main class="wrap"><p class="eyebrow">Find your starting point</p><h1>Explore the<br/><em>home.</em></h1><p class="intro">Room-by-room ideas for making everyday spaces work a little better.</p><div class="grid">{categories.map((category,i)=><a href={'/'+category.slug}><span>0{i+1}</span><h2>{category.title}</h2><p>{category.intro}</p><b>Explore ↗</b></a>)}</div></main><footer><a href="/">TROVE &amp; TIER</a><span>Thoughtful finds. Better living.</span></footer></BaseLayout>
<style>.wrap{max-width:1160px;margin:auto;padding:80px 5% 110px}.eyebrow{font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--color-deep-sage)}h1{font:clamp(65px,9vw,110px)/.9 var(--font-display);margin:25px 0}h1 em{font-weight:400;color:var(--color-deep-sage)}.intro{font-size:14px;color:#62645b;max-width:480px;line-height:1.8}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:55px}.grid a{min-height:205px;padding:24px;background:#f1ece3;text-decoration:none;display:flex;flex-direction:column;align-items:start}.grid a:nth-child(3n+2){background:#d8d7c9}.grid a:nth-child(3n){background:#d9d3c8}.grid span{font-size:9px;letter-spacing:.15em}.grid h2{font:36px var(--font-display);margin:22px 0 5px}.grid p{font-size:12px;line-height:1.7;color:#62645b;max-width:400px;margin:0 0 20px}.grid b{font-size:10px;font-weight:500;margin-top:auto}footer{background:var(--color-charcoal);color:var(--color-ivory);padding:25px 5%;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.15em}footer a{color:inherit;text-decoration:none}@media(max-width:600px){.grid{grid-template-columns:1fr}footer{flex-direction:column;gap:10px}}</style>
