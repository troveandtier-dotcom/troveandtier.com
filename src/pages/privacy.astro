---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro';
---
<BaseLayout title="Privacy — Trove & Tier"><Header/><main class="wrap"><p class="eyebrow">Your information</p><h1>Privacy<br/><em>matters.</em></h1><p class="copy">This is a pre-launch privacy-policy placeholder, not a final legal notice. Before enabling analytics, contact forms, newsletter subscriptions or user accounts, Trove &amp; Tier must publish a complete policy identifying the data collected, purposes, processors, retention periods, international transfers and applicable user rights. No newsletter or contact data is currently collected through this page.</p></main><footer><a href="/">TROVE &amp; TIER</a><span>HOME &amp; LIVING</span></footer></BaseLayout>
<style>.wrap{max-width:1000px;margin:auto;padding:80px 5% 110px}.eyebrow{font-size:9px;letter-spacing:.18em;color:var(--color-deep-sage);text-transform:uppercase}h1{font:clamp(65px,9vw,110px)/.9 var(--font-display);margin:25px 0 55px}h1 em{color:var(--color-deep-sage);font-weight:400}.copy{max-width:680px;margin-left:auto;font-size:14px;line-height:1.95;color:#5f6158}footer{background:var(--color-charcoal);color:var(--color-ivory);padding:25px 5%;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.15em}footer a{color:inherit;text-decoration:none}</style>
