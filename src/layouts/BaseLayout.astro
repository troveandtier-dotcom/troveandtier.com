---
import '../styles/tokens.css';
const { title = 'Trove & Tier — Thoughtful finds. Better living.', description = 'Thoughtful home finds, practical ideas and considered essentials for better living.', noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#E9E2D7" />
    <link rel="icon" type="image/png" href="/brand-mark.png" />
    <link rel="apple-touch-icon" href="/brand-mark.png" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body><slot /></body>
</html>