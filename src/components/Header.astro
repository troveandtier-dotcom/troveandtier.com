---
const links = [
  ['Home','/'],['Journal','/journal'],['Kitchen','/kitchen'],['Bathroom','/bathroom'],['Bedroom','/bedroom'],['Closet','/closet'],
  ['Laundry','/laundry'],['Small spaces','/small-spaces'],['The Edit','/the-edit']
];
---
<header class="site-header">
  <a class="brand-lockup" href="/" aria-label="Trove & Tier — Thoughtful finds. Better living.">
    <img class="brand-mark" src="/images/brand/trove-tier-logo.png" alt="Trove & Tier geometric monogram" width="72" height="72" />
    <span class="brand-tagline">Thoughtful finds. Better living.</span>
    <span class="brand-descriptor">HOME &amp; LIVING</span>
  </a>
  <nav class="desktop-nav" aria-label="Main navigation">{links.map(([label,url]) => <a href={url}>{label}</a>)}</nav>
  <div class="header-tools">
    <a class="search" href="/search" aria-label="Search">Search ↗</a>
    <label class="region"><span class="sr-only">Choose your region</span><select id="region-select" aria-label="Choose your region"><option value="US">US</option><option value="UK">UK</option><option value="CA">Canada</option></select></label>
    <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>{links.map(([label,url]) => <a href={url}>{label}</a>)}</nav>
</header>
<script>
  const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const mobile = document.querySelector<HTMLElement>('#mobile-nav');
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') === 'true';
    menu.setAttribute('aria-expanded', String(!open));
    if (mobile) mobile.hidden = open;
  });
  mobile?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && mobile) {
      mobile.hidden = true;
      menu.setAttribute('aria-expanded', 'false');
      menu.focus();
    }
  });
  const region = document.querySelector<HTMLSelectElement>('#region-select');
  if (region) {
    try {
      const saved = localStorage.getItem('tt-region');
      if (saved && ['US','UK','CA'].includes(saved)) region.value = saved;
    } catch { /* storage may be unavailable */ }
    region.addEventListener('change', () => {
      try { localStorage.setItem('tt-region', region.value); } catch { /* storage may be unavailable */ }
      window.dispatchEvent(new CustomEvent('tt-region-change', { detail: { market: region.value } }));
    });
  }
</script>
<style>
.site-header{max-width:var(--content-width);margin:auto;padding:22px 4.5% 16px;display:grid;grid-template-columns:1fr auto 1fr;grid-template-rows:auto auto;align-items:center;gap:15px 20px;border-bottom:1px solid var(--line);position:relative}
.brand-lockup{grid-column:2;grid-row:1;display:flex;flex-direction:column;align-items:center;gap:3px;text-decoration:none;text-align:center}.brand-mark{width:68px;height:68px;object-fit:contain;display:block}.brand-tagline{font:24px/1.05 var(--font-display);letter-spacing:.005em;color:var(--color-charcoal)}.brand-descriptor{font:8px/1.2 var(--font-body);letter-spacing:.24em;color:var(--color-deep-sage);margin-top:3px}
.desktop-nav{grid-column:1/-1;grid-row:2;display:flex;gap:clamp(12px,2.1vw,26px);align-items:center;justify-content:center}.desktop-nav a,.search{font-size:10px;text-decoration:none;white-space:nowrap;letter-spacing:.025em}.desktop-nav a:hover,.search:hover{text-decoration:underline;text-underline-offset:5px}.header-tools{grid-column:3;grid-row:1;justify-self:end;display:flex;align-items:center;gap:12px}.region select{border:0;background:transparent;color:inherit;font-size:11px}.menu-toggle,.mobile-nav{display:none}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:1050px){.desktop-nav{display:none}.site-header{grid-template-columns:1fr 1fr;grid-template-rows:auto}.brand-lockup{grid-column:1;grid-row:1;align-items:flex-start;text-align:left}.brand-mark{width:58px;height:58px}.brand-tagline{font-size:22px}.header-tools{grid-column:2;grid-row:1}.menu-toggle{display:block;border:1px solid var(--line);background:transparent;padding:9px 12px;font-size:11px}.mobile-nav:not([hidden]){display:grid;position:absolute;z-index:5;top:100%;left:0;right:0;background:var(--color-paper);padding:22px 5%;grid-template-columns:repeat(2,1fr);border-bottom:1px solid var(--line)}}
@media(max-width:520px){.site-header{padding:14px 5%}.brand-mark{width:48px;height:48px}.brand-tagline{font-size:18px}.brand-descriptor{font-size:7px}.search{display:none}.header-tools{gap:8px}}
</style>