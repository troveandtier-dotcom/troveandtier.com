---
const links = [
  ['Kitchen','/kitchen'],['Bathroom','/bathroom'],['Bedroom','/bedroom'],['Closet','/closet'],
  ['Laundry','/laundry'],['Small spaces','/small-spaces'],['The Edit','/the-edit'],['Journal','/journal'],['All rooms','/categories']
];
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Trove & Tier home">
    <span class="brand-mark" aria-hidden="true">T</span>
    <span class="brand-type"><strong>TROVE &amp; TIER</strong><small>HOME &amp; LIVING</small></span>
  </a>
  <nav aria-label="Main navigation">{links.map(([label,url]) => <a href={url}>{label}</a>)}</nav>
  <div class="header-tools">
    <a class="search" href="/search" aria-label="Search">Search ↗</a>
    <label class="region"><span class="sr-only">Choose your region</span><select id="region-select" aria-label="Choose your region"><option value="US">US</option><option value="UK">UK</option><option value="CA">Canada</option></select></label>
    <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>{links.map(([label,url]) => <a href={url}>{label}</a>)}</nav>
</header>
<script>
  const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const mobile = document.querySelector<HTMLElement>('#mobile-nav');
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') === 'true';
    menu.setAttribute('aria-expanded', String(!open));
    if (mobile) mobile.hidden = open;
  });
  mobile?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && mobile) {
      mobile.hidden = true;
      menu.setAttribute('aria-expanded', 'false');
      menu.focus();
    }
  });
  const region = document.querySelector<HTMLSelectElement>('#region-select');
  if (region) {
    try {
      const saved = localStorage.getItem('tt-region');
      if (saved && ['US','UK','CA'].includes(saved)) region.value = saved;
      region.addEventListener('change', () => {
        try { localStorage.setItem('tt-region', region.value); } catch { /* storage may be unavailable */ }
      });
    } catch { /* storage may be unavailable */ }
  }
</script>
<style>
.site-header{max-width:var(--content-width);margin:auto;padding:22px 4.5%;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid var(--line);position:relative}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;min-width:205px}.brand-mark{width:42px;height:42px;background:var(--color-charcoal);color:var(--color-ivory);display:grid;place-items:center;font:34px var(--font-display)}.brand-type{display:grid;gap:3px;letter-spacing:.12em;font-size:12px}.brand-type small{font-size:9px;letter-spacing:.2em}
nav{display:flex;gap:18px;align-items:center}nav a,.search{font-size:11px;text-decoration:none;white-space:nowrap}nav a:hover,.search:hover{text-decoration:underline;text-underline-offset:5px}.header-tools{display:flex;align-items:center;gap:12px}.region select{border:0;background:transparent;color:inherit;font-size:11px}.menu-toggle,.mobile-nav{display:none}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:1050px){.site-header>nav{display:none}.menu-toggle{display:block;border:1px solid var(--line);background:transparent;padding:9px 12px;font-size:11px}.mobile-nav:not([hidden]){display:grid;position:absolute;z-index:5;top:100%;left:0;right:0;background:var(--color-paper);padding:22px 5%;grid-template-columns:repeat(2,1fr);border-bottom:1px solid var(--line)}}
@media(max-width:520px){.site-header{padding:16px 5%}.brand{min-width:0}.brand-mark{width:36px;height:36px}.brand-type{font-size:10px}.search{display:none}}
</style>
