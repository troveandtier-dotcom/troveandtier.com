# Astro build-time public values. Protected by Supabase Row Level Security.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Cloudflare Worker runtime values (configure in Cloudflare, not in browser code).
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY
# AFFILIATE_HOST_ALLOWLIST=approved-network-host.example

# Secret only: set through Wrangler/Cloudflare secret management; never commit a value.
# SUPABASE_SERVICE_ROLE_KEY=DO_NOT_PUT_A_REAL_VALUE_HERE
