{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trove-and-tier-redirects",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/go/*"]
  }
}
